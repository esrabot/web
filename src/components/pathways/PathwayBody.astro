---
/**
 * The full detail of one way in, from src/content/pathways.yaml: the
 * opening paragraph, the headed sections (lists, tables, short
 * paragraphs), the highlighted notes, and how to take the first step.
 *
 * Used in two places, so the copy (the partnership levels above all)
 * lives in one file and is never retyped: the pop-ups on the home page,
 * and the sections of /partner.
 *
 * `idPrefix` gives each section heading an id ("companies-partnership-
 * levels"), so a link can land on it. The home page leaves it off: its
 * four pop-ups share section names and would repeat ids.
 */
import type { CollectionEntry } from 'astro:content';

import DataTable from '../ui/DataTable.astro';

interface Props {
  way: CollectionEntry<'pathways'>['data'];
  idPrefix?: string;
}

const { way, idPrefix } = Astro.props;

const slug = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const sectionId = (heading: string) => (idPrefix ? `${idPrefix}-${slug(heading)}` : undefined);
---

<div class="pathway">
  <p class="intro">{way.intro}</p>

  {
    /* Lists sit side by side where there is room; a table or a paragraph
      takes the full width. */
  }
  <div class="sections">
    {
      way.sections.map((s) => (
        <section class:list={{ full: !s.items }} id={sectionId(s.heading)}>
          <h3>{s.heading}</h3>
          {s.items && (
            <ul>
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {s.table && (
            <DataTable
              columns={s.table.columns}
              rows={s.table.rows.map((r) => r.cells)}
              note={s.table.note}
              label={s.heading}
            />
          )}
          {s.text && <p class="text">{s.text}</p>}
        </section>
      ))
    }
  </div>

  {
    way.notes.length > 0 && (
      <div class="notes">
        {way.notes.map((n) => (
          <aside class="note">
            <p class="note-label">{n.label}</p>
            <p>{n.body}</p>
          </aside>
        ))}
      </div>
    )
  }

  {
    way.start && (
      <section class="start">
        <h3>How to start</h3>
        <p>{way.start}</p>
      </section>
    )
  }
</div>

<style>
  .intro {
    max-width: var(--measure);
    margin: 0;
    font-size: var(--t-md);
    color: var(--ink-body);
  }

  /* Lists share a row where there is room, each growing to fill it; a
     table or a paragraph always takes a row of its own. Flex rather than
     grid, so a list left alone on a row grows to the full width instead
     of leaving an empty track beside it. */
  .sections {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .sections > section {
    flex: 1 1 13rem;
    /* Lets a wide table scroll inside its own box instead of stretching
       the page or the pop-up. */
    min-width: 0;
    scroll-margin-top: calc(var(--header-h) + var(--space-5));
  }

  .sections > section.full {
    flex-basis: 100%;
  }

  h3 {
    margin-bottom: var(--space-3);
    font-size: var(--t-base);
    letter-spacing: 0;
    color: var(--ink-strong);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0 0 0 1.125rem;
  }

  li {
    padding-left: 0.125rem;
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--ink-body);
  }

  li::marker {
    color: var(--ink-faint);
  }

  .text {
    margin: 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  .notes {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .note {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--band-edge);
    border-radius: var(--r-md);
    background: var(--band);
  }

  .note p {
    margin: 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  .note .note-label {
    margin-bottom: var(--space-1);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .start {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-soft);
  }

  .start p {
    margin: 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }
</style>
