---
/**
 * A numbered display equation, set in the serif face.
 *
 * Deliberately not a LaTeX engine: the existing corpus needs simple
 * inline expressions, and KaTeX would add ~280 KB of JS plus a font to
 * every post that has one formula. If a post ever needs real maths,
 * add remark-math + rehype-katex and this component can defer to it.
 *
 * Usage in markdown:
 *   <Eq n="1">τ_out = N · k_t · i_q − τ_f</Eq>
 */
interface Props {
  /** Equation number shown at the right-hand edge. */
  n?: string | number;
}

const { n } = Astro.props;
---

<div class="eq" role="math">
  <span class="body"><slot /></span>
  {
    n && (
      <span class="num" aria-hidden="true">
        ({n})
      </span>
    )
  }
</div>

<style>
  .eq {
    position: relative;
    padding: var(--space-4) var(--space-7);
    border-radius: var(--r-md);
    background: var(--band);
    font-family: var(--font-display);
    font-size: var(--t-xl);
    line-height: 1.5;
    color: var(--ink-strong);
    text-align: center;
  }

  .body {
    font-style: italic;
  }

  .num {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-style: normal;
    color: var(--ink-muted);
  }
</style>
