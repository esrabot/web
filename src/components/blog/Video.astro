---
/**
 * Self-hosted video in a rounded frame.
 *
 * Usage in markdown:
 *   <Video src="/media/running-leg.mp4" caption="Leg integration test." />
 *
 * Muted+loop videos autoplay (they read as animated figures); anything
 * with sound gets controls and never autoplays.
 */
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  /** A short label set over the corner of the frame. */
  plate?: string;
  /** Silent looping clip presented as a figure. */
  ambient?: boolean;
  ratio?: string;
}

const { src, poster, caption, plate, ambient = false, ratio = '16/9' } = Astro.props;
---

<figure class="video-fig">
  <div class="well" style={`aspect-ratio: ${ratio};`}>
    <video
      src={src}
      poster={poster}
      controls={!ambient}
      autoplay={ambient}
      loop={ambient}
      muted={ambient}
      playsinline
      preload="metadata"></video>
    {plate && <span class="corner">{plate}</span>}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .video-fig {
    margin: 0;
  }

  .well {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--navy);
    box-shadow: var(--shadow-sm);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .corner {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    padding: 0.25rem 0.625rem;
    border-radius: var(--r-sm);
    background: rgba(255, 255, 255, 0.92);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-strong);
    pointer-events: none;
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }
</style>
