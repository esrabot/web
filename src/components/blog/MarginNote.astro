---
/**
 * A Tufte-style side note. Floats into the margin column on wide screens
 * and folds inline on narrow ones, so it never gets orphaned.
 *
 * Usage in markdown:
 *   <MarginNote n="1">Gear ratio near N = 6 keeps reflected inertia low.</MarginNote>
 */
interface Props {
  /** Marker number, matched to a <sup> in the body text. */
  n?: number | string;
}

const { n } = Astro.props;
---

<aside class="margin-note">
  {n && <sup class="marker">{n}</sup>}
  <slot />
</aside>

<style>
  .margin-note {
    float: right;
    clear: right;
    width: var(--margin-col);
    margin-right: calc(-1 * var(--margin-gutter));
    margin-bottom: var(--space-5);
    padding-left: var(--space-4);
    border-left: 2px solid var(--blue-soft);
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  /* Markdown wraps the note's text in a paragraph; the marker is floated
     so it sits at the start of that first line rather than above it. */
  .marker {
    float: left;
    margin-right: 0.375rem;
    font-size: 0.75em;
    font-weight: var(--w-semibold);
    line-height: 1.6;
    color: var(--blue);
  }

  .margin-note :global(p) {
    margin: 0;
  }

  .margin-note :global(p + p) {
    margin-top: 0.5em;
  }

  /* Below the margin-column breakpoint, fold inline as a ruled aside
     rather than floating into space that no longer exists. */
  @media (max-width: 1100px) {
    .margin-note {
      float: none;
      width: auto;
      margin-right: 0;
      margin-bottom: 0;
    }
  }
</style>
