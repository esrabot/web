---
/**
 * An aside: a tinted block with a small label.
 *
 * Usage in markdown:
 *   <Callout kind="warn" title="Mind the enamel">
 *   Over-tensioning nicks the wire and shorts a turn.
 *   </Callout>
 */
interface Props {
  kind?: 'note' | 'warn' | 'spec';
  title?: string;
}

const { kind = 'note', title } = Astro.props;
const defaultTitle = { note: 'Note', warn: 'Caution', spec: 'Spec' }[kind];
---

<aside class:list={['callout', kind]}>
  <p class="label">{title ?? defaultTitle}</p>
  <div class="body"><slot /></div>
</aside>

<style>
  .callout {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--blue-soft);
    border-left: 4px solid var(--blue);
    border-radius: var(--r-md);
    background: var(--blue-wash);
  }

  .callout.warn {
    border-color: var(--sand-deep);
    border-left-color: var(--sand-ink);
    background: var(--sand);
  }

  .callout.spec {
    border-color: var(--rule);
    border-left-color: var(--ink-strong);
    background: var(--surface);
  }

  .label {
    margin: 0 0 var(--space-1);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue-strong);
  }

  .warn .label {
    color: var(--sand-ink);
  }

  .spec .label {
    color: var(--ink-muted);
  }

  .body {
    font-size: var(--t-base);
    line-height: 1.65;
    color: var(--ink-body);
  }

  .body :global(> :first-child) {
    margin-top: 0;
  }
  .body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
