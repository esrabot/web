---
/**
 * A figure, addressed by asset path rather than by import.
 *
 * Usage in markdown:
 *   <Fig src="uploads/test-stand.jpg" alt="The leg test stand."
 *        caption="**Figure 1.** Assembled on a linear slide." />
 *
 * `margin` floats it into the side-note column beside the text.
 * A bad path fails the build with the available paths listed, rather than
 * silently rendering an empty frame.
 */
import Figure from '../ui/Figure.astro';
import { resolveAsset, requireAsset } from '../../lib/assets';

interface Props {
  src: string;
  alt?: string;
  caption?: string;
  plate?: string;
  ref?: string;
  ratio?: string;
  /** Float into the margin column. */
  margin?: boolean;
  /** Accepted for older posts; photos now print in full colour. */
  dither?: boolean;
  mono?: boolean;
}

const { src, alt = '', caption, plate, ref, ratio, margin = false } = Astro.props;

// Remote and /public sources pass through untouched; local ones must exist.
const resolved = resolveAsset(src) ? requireAsset(src, `<Fig src="${src}" />`) : src;
---

<div class:list={['fig-wrap', { margin }]}>
  <Figure
    src={resolved}
    alt={alt}
    caption={caption}
    plate={plate}
    ref={ref}
    ratio={ratio ?? (margin ? '1/1' : '16/9')}
    width={margin ? 560 : 1200}
  />
</div>

<style>
  .fig-wrap.margin {
    float: right;
    clear: right;
    width: var(--margin-col);
    margin-right: calc(-1 * var(--margin-gutter));
    margin-bottom: var(--space-5);
  }

  @media (max-width: 1100px) {
    .fig-wrap.margin {
      float: none;
      width: auto;
      margin-right: 0;
      margin-bottom: 0;
    }
  }
</style>
