---
/**
 * Bill of materials.
 *
 * Open hardware is only reproducible if the parts list ships with the
 * design, so a BOM is a first-class content type rather than a hand-built
 * table. Data lives in src/content/boms/*.yaml.
 *
 * Usage in markdown:
 *   <BOM id="leg-test-stand" />
 *
 * On cost reporting: the component sums ONLY lines where unitPrice and
 * unitQty are both present, and says so in the total's label. It never
 * infers a missing quantity as 1 or presents a partial sum as a project
 * total — an understated BOM total is actively misleading to someone
 * budgeting a rebuild.
 */
import { getEntry } from 'astro:content';

interface Props {
  id: string;
  /** Hide the vendor column on narrow embeds. */
  compact?: boolean;
}

const { id, compact = false } = Astro.props;

const bom = await getEntry('boms', id);
if (!bom) {
  throw new Error(
    `<BOM id="${id}" /> — no such BOM. Expected src/content/boms/${id}.yaml. ` +
      `Check the filename matches the id.`
  );
}

const { title, subject, currency, notes, lines, updated } = bom.data;

const priced = lines.filter((l) => l.unitPrice !== undefined && l.unitQty !== undefined);
const subtotal = priced.reduce((sum, l) => sum + l.unitPrice! * l.unitQty!, 0);
const unpriced = lines.length - priced.length;
const outstanding = lines.filter((l) => !l.purchased).length;

const money = (n: number) =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(n);
---

<figure class="bom">
  <figcaption class="head">
    <div>
      <p class="kicker">Bill of materials</p>
      <strong>{title}</strong>
      {subject && <span class="subject">{subject}</span>}
    </div>
    <p class="head-meta">
      {lines.length} lines · {outstanding} outstanding
      {
        updated && (
          <>
            <br />
            Updated {updated.toISOString().slice(0, 10)}
          </>
        )
      }
    </p>
  </figcaption>

  <div class="scroll" tabindex="0" role="group" aria-label={`${title}: parts list`}>
    <table>
      <thead>
        <tr>
          <th scope="col" class="c-status"><span class="sr-only">Purchased</span></th>
          {!compact && <th scope="col">Vendor</th>}
          <th scope="col">Item</th>
          <th scope="col" class="c-qty">Qty</th>
          <th scope="col" class="c-num">Unit</th>
          <th scope="col" class="c-num">×</th>
        </tr>
      </thead>
      <tbody>
        {
          lines.map((line) => (
            <tr class:list={{ pending: !line.purchased }}>
              <td class="c-status">
                <span class:list={['dot', { on: line.purchased }]} aria-hidden="true" />
                <span class="sr-only">{line.purchased ? 'Purchased' : 'Not purchased'}</span>
              </td>
              {!compact && <td class="vendor">{line.vendor ?? '—'}</td>}
              <td class="item">
                <span class="item-name">{line.item}</span>
                {line.notes && <span class="notes">{line.notes}</span>}
                {line.links.length > 0 && (
                  <span class="links">
                    {line.links.map((l) => (
                      <a href={l.url} rel="noopener" target="_blank">
                        {l.label} &#8599;
                      </a>
                    ))}
                  </span>
                )}
              </td>
              <td class="c-qty">{line.qty ?? ''}</td>
              <td class="c-num">{line.unitPrice !== undefined ? money(line.unitPrice) : ''}</td>
              <td class="c-num">{line.unitQty ?? ''}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="foot">
    <p class="sum">
      {/* Deliberately not called a project total — see the note above. */}
      Sum of {priced.length} priced {priced.length === 1 ? 'line' : 'lines'}:{' '}
      <strong>{money(subtotal)}</strong>
      {
        unpriced > 0 && (
          <>
            {' '}
            · {unpriced} {unpriced === 1 ? 'line has' : 'lines have'} no price recorded
          </>
        )
      }
    </p>
    {notes && <p class="bom-notes">{notes}</p>}
  </div>
</figure>

<style>
  .bom {
    margin: 0;
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--rule-soft);
    background: var(--bg);
  }

  .kicker {
    margin: 0 0 var(--space-1);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue);
  }

  .head strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 560;
    line-height: var(--lh-snug);
    color: var(--ink-strong);
  }

  .subject {
    display: block;
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .head-meta {
    flex: none;
    margin: 0;
    font-size: var(--t-xs);
    line-height: 1.6;
    color: var(--ink-muted);
    text-align: right;
    white-space: nowrap;
  }

  /* The table scrolls inside its own box so the page never scrolls
     sideways on a phone. */
  .scroll {
    overflow-x: auto;
  }

  .scroll:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }

  table {
    /* Stated outright: inside a post, Prose would otherwise turn a bare
       table into its own scrolling block. This one already has .scroll. */
    display: table;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  th {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.6875rem;
    font-weight: var(--w-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-align: left;
    white-space: nowrap;
  }

  td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }

  tbody tr {
    transition: background-color var(--dur-fast) var(--ease);
  }

  tbody tr:hover {
    background: var(--blue-wash);
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  th:first-child,
  td:first-child {
    padding-left: var(--space-5);
  }

  th:last-child,
  td:last-child {
    padding-right: var(--space-5);
  }

  .item-name {
    display: block;
    color: var(--ink-strong);
  }

  tr.pending .item-name {
    color: var(--ink-muted);
  }

  .c-status {
    width: 1.5rem;
  }

  /* Filled once bought, hollow until then. */
  .dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid var(--ink-faint);
    border-radius: 50%;
    vertical-align: 0.05em;
  }

  .dot.on {
    border-color: var(--blue);
    background: var(--blue);
  }

  .vendor {
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .notes {
    display: block;
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: 0.125rem;
    font-size: var(--t-xs);
  }

  .links a {
    color: var(--blue);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .c-qty {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .c-num {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    text-align: right;
    white-space: nowrap;
    /* Tabular figures so prices align down the column. */
    font-variant-numeric: tabular-nums;
  }

  .foot {
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--rule-soft);
    background: var(--bg);
  }

  .sum {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .sum strong {
    font-variant-numeric: tabular-nums;
    color: var(--ink-strong);
  }

  .bom-notes {
    max-width: 60ch;
    margin: var(--space-2) 0 0;
    font-size: var(--t-xs);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  @media (max-width: 560px) {
    .head {
      flex-direction: column;
      gap: var(--space-2);
    }

    .head-meta {
      text-align: left;
    }
  }
</style>
