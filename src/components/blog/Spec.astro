---
/**
 * A specification table — key/value pairs.
 *
 * Usage in markdown:
 *   <Spec items={[
 *     ['Slots / poles', '21 / 14'],
 *     ['Winding', '32 turns, 24 AWG, wye'],
 *     ['Reduction', 'N = 6'],
 *   ]} />
 */
interface Props {
  items: [string, string][];
  title?: string;
  /** Two columns of pairs instead of one. */
  dense?: boolean;
}

const { items, title, dense = false } = Astro.props;
---

<div class:list={['spec', { dense }]}>
  {title && <p class="title">{title}</p>}
  <dl>
    {
      items.map(([key, value]) => (
        <div class="pair">
          <dt>{key}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .spec {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
  }

  .title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue);
  }

  dl {
    display: grid;
    margin: 0;
  }

  .dense dl {
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-6);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(7.5rem, 38%) 1fr;
    gap: var(--space-4);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .pair:last-child {
    border-bottom: 0;
  }

  dt {
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
    font-size: var(--t-base);
    font-variant-numeric: tabular-nums;
    color: var(--ink-strong);
  }

  @media (max-width: 620px) {
    .dense dl {
      grid-template-columns: 1fr;
    }
    .pair {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
