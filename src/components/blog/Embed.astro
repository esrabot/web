---
/**
 * Third-party embed (YouTube today; extendable).
 *
 * Renders as a click-to-load facade: a poster frame plus a play control
 * that swaps in the iframe on demand. Nothing from the provider loads —
 * no iframe, no cookies, no tracking — until the reader opts in, which
 * keeps the page fast and avoids embedding trackers by default.
 *
 * Usage in markdown:
 *   <Embed youtube="dQw4w9WgXcQ" caption="Bring-up walkthrough." />
 */
interface Props {
  youtube?: string;
  /** Full URL, used when the provider isn't YouTube. */
  url?: string;
  title?: string;
  caption?: string;
}

const { youtube, url, title = 'Embedded video', caption } = Astro.props;

// youtube-nocookie serves the same player without setting tracking cookies.
const embedUrl = youtube ? `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1` : url;

// Thumbnails come from a separate image host that sets no cookies.
const poster = youtube ? `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg` : undefined;
---

<figure class="embed">
  <div class="frame" data-embed={embedUrl} data-title={title}>
    {
      poster ? (
        <img src={poster} alt="" loading="lazy" decoding="async" class="poster" />
      ) : (
        <div class="poster placeholder" />
      )
    }
    <button type="button" class="play">
      <span class="tri" aria-hidden="true"></span>
      <span class="sr-only">Load and play: {title}</span>
    </button>
    <span class="notice">Loads from {youtube ? 'YouTube' : 'the provider'} on play</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // Progressive enhancement: with no JS the facade simply stays a poster
  // and the caption/link still communicate what the video is.
  document.querySelectorAll<HTMLElement>('.embed .frame').forEach((frame) => {
    frame.querySelector('.play')?.addEventListener('click', () => {
      const src = frame.dataset.embed;
      if (!src) return;

      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = frame.dataset.title ?? 'Embedded video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';

      frame.replaceChildren(iframe);
    });
  });
</script>

<style>
  .embed {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--sand);
    box-shadow: var(--shadow-sm);
  }

  .frame :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: linear-gradient(rgba(15, 29, 53, 0.08), rgba(15, 29, 53, 0.32));
    cursor: pointer;
  }

  .play:focus-visible {
    outline-offset: -4px;
    border-radius: var(--r-lg);
  }

  .tri {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow-md);
    transition: background-color var(--dur) var(--ease);
  }

  .tri::after {
    content: '';
    margin-left: 0.3rem;
    border-left: 1.1rem solid var(--blue);
    border-top: 0.7rem solid transparent;
    border-bottom: 0.7rem solid transparent;
    transition: border-left-color var(--dur) var(--ease);
  }

  .play:hover .tri {
    background: var(--blue);
  }

  .play:hover .tri::after {
    border-left-color: var(--ink-inverse);
  }

  .notice {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 0.25rem 0.625rem;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.92);
    font-size: 0.6875rem;
    font-weight: var(--w-semibold);
    color: var(--ink-strong);
    pointer-events: none;
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }
</style>
