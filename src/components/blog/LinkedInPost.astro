---
/**
 * A featured LinkedIn post.
 *
 * Rendered as a card in the site's own idiom, with LinkedIn's official
 * embed loaded only when the reader asks for it. Two reasons for the
 * facade rather than a bare iframe:
 *
 *  - LinkedIn's embed sets cookies and pulls a large third-party bundle.
 *    Not loading it until someone opts in keeps the page static and
 *    avoids shipping a tracker to every visitor.
 *  - The raw embed carries LinkedIn's own visual language, which sits
 *    badly against this design. The card matches the site; the embed
 *    appears in place once expanded.
 *
 * Usable in MDX too: <LinkedInPost activityId="7394171470467223552" title="…" />
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** Digits from urn:li:activity:<id>. */
  activityId: string;
  title: string;
  summary?: string;
  /** Source label, e.g. "ESRA". */
  source?: string;
  /** Canonical post URL, for the "open on LinkedIn" link. */
  url?: string;
  date?: Date;
}

const { activityId, title, summary, source = 'LinkedIn', url, date } = Astro.props;

const embedSrc = `https://www.linkedin.com/embed/feed/update/urn:li:activity:${activityId}`;
const postUrl = url ?? `https://www.linkedin.com/feed/update/urn:li:activity:${activityId}/`;
---

<article class="li-card" data-embed={embedSrc}>
  <div class="head">
    <span class="source">
      <Icon name="simple-icons:linkedin" class="li-icon" aria-hidden="true" />
      LinkedIn · {source}
    </span>
    {date && <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>}
  </div>

  <div class="body">
    <h3>{title}</h3>
    {summary && <p>{summary}</p>}
  </div>

  <div class="actions">
    <button type="button" class="load" aria-expanded="false">Show post</button>
    <a href={postUrl} rel="noopener" target="_blank">Open on LinkedIn &#8599;</a>
  </div>

  <div class="slot" hidden></div>
</article>

<script>
  // Progressive enhancement. With no JS the card still shows the title,
  // the summary, and a working link to the post.
  document.querySelectorAll<HTMLElement>('.li-card').forEach((card) => {
    const button = card.querySelector<HTMLButtonElement>('.load');
    const slot = card.querySelector<HTMLElement>('.slot');
    const src = card.dataset.embed;
    if (!button || !slot || !src) return;

    const setOpen = (open: boolean) => {
      slot.hidden = !open;
      button.textContent = open ? 'Hide post' : 'Show post';
      button.setAttribute('aria-expanded', String(open));
    };

    button.addEventListener('click', () => {
      // The embed is only created on the first press; after that the
      // button just shows and hides it.
      if (slot.childElementCount === 0) {
        const frame = document.createElement('iframe');
        frame.src = src;
        frame.title = 'LinkedIn post';
        frame.loading = 'lazy';
        frame.allowFullscreen = true;
        slot.appendChild(frame);
        setOpen(true);
        return;
      }
      setOpen(slot.hidden);
    });
  });
</script>

<style>
  .li-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    color: var(--ink-muted);
  }

  .source {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--blue);
  }

  .li-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .body {
    flex: 1;
    padding-top: var(--space-3);
  }

  h3 {
    font-size: var(--t-xl);
  }

  .body p {
    margin: var(--space-2) 0 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-soft);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
  }

  .load {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--blue);
  }

  .load:hover {
    color: var(--blue-strong);
    text-decoration: underline;
  }

  .actions a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .actions a:hover {
    color: var(--blue);
  }

  .slot {
    margin-top: var(--space-4);
  }

  .slot :global(iframe) {
    display: block;
    width: 100%;
    height: 35rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    background: var(--surface);
  }
</style>
