---
/**
 * A repository card with live figures.
 *
 * Usage in markdown:
 *   <Repo name="esrabot/mjlab" />
 *
 * Stars, language, and last-push are fetched at build. If the repo can't
 * be resolved — private, renamed, or the API is down — the card still
 * renders with the name and a link, minus the figures. It never shows a
 * placeholder number.
 */
import { Icon } from 'astro-icon/components';

import { getRepo, updatedLabel } from '../../lib/github';

interface Props {
  name: string;
  /** Override the fetched description. */
  summary?: string;
}

const { name, summary } = Astro.props;
const repo = await getRepo(name);

const fullName = repo?.fullName ?? (name.includes('/') ? name : `esrabot/${name}`);
const url = repo?.url ?? `https://github.com/${fullName}`;
const description = summary ?? repo?.description ?? null;
---

<a class="repo" href={url} rel="noopener" target="_blank">
  <div class="top">
    <Icon name="simple-icons:github" class="gh" aria-hidden="true" />
    <span class="name">{fullName}</span>
    {repo?.isArchived && <span class="badge">Archived</span>}
    <Icon name="lucide:arrow-up-right" class="out" aria-hidden="true" />
  </div>

  {description && <p class="desc">{description}</p>}

  {
    repo ? (
      <div class="stats">
        {repo.language && <span>{repo.language}</span>}
        <span>&#9733; {repo.stars}</span>
        {repo.forks > 0 && <span>{repo.forks} forks</span>}
        {repo.pushedAt && <span>{updatedLabel(repo.pushedAt)}</span>}
      </div>
    ) : (
      /* No fabricated figures — just say the data isn't available. */
      <div class="stats">
        <span>Repository details unavailable</span>
      </div>
    )
  }
</a>

<style>
  .repo {
    display: block;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
    color: var(--ink-strong);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }

  .repo:hover {
    border-color: var(--blue);
    color: var(--ink-strong);
  }

  .top {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .gh {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--ink-strong);
  }

  .name {
    font-family: var(--font-mono);
    font-size: var(--t-base);
    font-weight: var(--w-medium);
    overflow-wrap: anywhere;
  }

  .badge {
    padding: 0.1rem 0.5rem;
    border-radius: var(--r-sm);
    background: var(--band);
    font-size: 0.6875rem;
    font-weight: var(--w-semibold);
    color: var(--ink-muted);
  }

  .out {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-left: auto;
    color: var(--ink-faint);
    transition: color var(--dur) var(--ease);
  }

  .repo:hover .out {
    color: var(--blue);
  }

  .desc {
    margin: var(--space-2) 0 0;
    font-size: var(--t-base);
    line-height: 1.55;
    color: var(--ink-body);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-soft);
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }
</style>
