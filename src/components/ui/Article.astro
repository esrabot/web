---
/**
 * The shell for anything read top to bottom: a guide, a
 * project write-up.
 *
 * One centred column at the reading measure, holding a way back, the
 * title block, an optional cover, and the body. When the body contains
 * side notes (<MarginNote>, <Fig margin>) the column widens to make a
 * margin for them beside the text, and folds back to one column on
 * narrower screens.
 *
 * Slots:
 *   meta    under the lede: byline, dates, link chips
 *   cover   a lead image; it runs a little wider than the text
 *   default the body, rendered through Prose
 *   after   whatever follows the body (comments)
 *
 * Styles are global and namespaced (.article-*) because the layout has
 * to see into slotted content to know whether there are side notes.
 */
import { Icon } from 'astro-icon/components';

import Prose from './Prose.astro';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** The index this page belongs to. */
  back: { href: string; label: string };
}

const { eyebrow, title, lede, back } = Astro.props;
---

<article class="article">
  <div class="article-wash" aria-hidden="true"></div>

  <div class="article-shell">
    <a class="article-back" href={back.href} data-reveal="fade">
      <Icon name="lucide:arrow-left" aria-hidden="true" />
      {back.label}
    </a>

    <header class="article-head">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h1 data-reveal style="--i: 1">{title}</h1>
      {
        lede && (
          <p class="lede" data-reveal style="--i: 2">
            {lede}
          </p>
        )
      }
      {
        Astro.slots.has('meta') && (
          <div class="article-meta" data-reveal style="--i: 3">
            <slot name="meta" />
          </div>
        )
      }
    </header>

    {
      Astro.slots.has('cover') && (
        <div class="article-cover" data-reveal="scale" style="--i: 3">
          <slot name="cover" />
        </div>
      )
    }

    <div class="article-body">
      <Prose width="full">
        <slot />
      </Prose>
    </div>

    <slot name="after" />
  </div>
</article>

<style is:global>
  .article {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
    isolation: isolate;
  }

  .article-wash {
    position: absolute;
    inset: calc(-1 * var(--header-h)) 0 auto;
    z-index: -1;
    height: 34rem;
    background:
      radial-gradient(52rem 26rem at 88% 0%, var(--blue-soft), transparent 62%),
      radial-gradient(44rem 24rem at 4% 8%, var(--sand), transparent 64%);
    -webkit-mask-image: linear-gradient(#000 45%, transparent);
    mask-image: linear-gradient(#000 45%, transparent);
    pointer-events: none;
  }

  .article-shell {
    width: min(var(--measure), 100% - 2 * var(--gutter));
    margin-inline: auto;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-muted);
    text-decoration: none;
  }

  .article-back svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--dur) var(--ease-out);
  }

  .article-back:hover {
    color: var(--blue);
  }

  .article-back:hover svg {
    transform: translateX(-3px);
  }

  .article-head {
    margin-top: var(--space-6);
  }

  .article-head h1 {
    margin-top: var(--space-4);
    font-size: var(--t-h1);
    font-weight: 480;
    line-height: var(--lh-tight);
    letter-spacing: var(--track-display);
  }

  .article-head .lede {
    margin-top: var(--space-5);
  }

  .article-meta {
    margin-top: var(--space-6);
  }

  /* The cover runs wider than the text, centred on it, wherever the
     screen has the room. */
  .article-cover {
    --cover-w: min(54rem, 100vw - 2 * var(--gutter));
    width: var(--cover-w);
    display: flex;
    justify-content: center;
    margin-top: var(--space-7);
    margin-inline: calc((100% - var(--cover-w)) / 2);
  }

  /* The picture keeps its own proportions. A wide one fills the width; a
     tall one stops at a sensible height and sits centred, rather than
     pushing the first paragraph a full screen down. */
  .article-cover img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(40rem, 78vh);
    border-radius: var(--r-xl);
    background: var(--sand);
    box-shadow: var(--shadow-md);
  }

  .article-body {
    margin-top: var(--space-7);
    padding-top: var(--space-7);
    border-top: 1px solid var(--rule);
  }

  .article-cover + .article-body {
    padding-top: 0;
    border-top: 0;
  }

  /* Side notes float right of the text; clear them before what follows. */
  .article-body::after {
    content: '';
    display: block;
    clear: both;
  }

  /* With side notes: widen the column and keep a margin for them. */
  @media (min-width: 1101px) {
    .article-shell:has(.margin-note, .fig-wrap.margin) {
      width: min(calc(var(--measure) + var(--margin-gutter)), 100% - 2 * var(--gutter));
    }

    .article-shell:has(.margin-note, .fig-wrap.margin) .article-body {
      padding-right: var(--margin-gutter);
    }

    .article-shell:has(.margin-note, .fig-wrap.margin) .article-cover {
      --cover-w: 100%;
    }
  }
</style>
