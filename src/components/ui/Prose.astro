---
/**
 * Typographic container for rendered Markdown.
 *
 * Everything an author writes in a .md file lands here, so this is where
 * the reading experience is defined — measure, rhythm, code, quotes,
 * tables, footnotes. Guide and project bodies additionally reserve a margin
 * column for side notes; this handles the base flow.
 *
 * The styles are global and written to a deliberate specificity, because
 * the markup inside is generated and mixed with components:
 *
 *   - element defaults (links, lists, tables…) are `.prose :where(…)`,
 *     one class strong: enough to beat the site's base element rules,
 *     never enough to beat a component's own scoped styles. A parts table
 *     dropped into a post keeps its own table styling.
 *   - the vertical rhythm is `.prose.prose.prose > …`, three classes
 *     strong: the space between blocks belongs to the flow, so it wins
 *     over a component's own `margin: 0`.
 */
interface Props {
  /** `measure` for essays, `wide` for reference pages, `full` to fill. */
  width?: 'measure' | 'wide' | 'full';
  class?: string;
}

const { width = 'measure', class: className } = Astro.props;
---

<div class:list={['prose', `w-${width}`, className]}>
  <slot />
</div>

<style is:global>
  .prose {
    color: var(--ink-body);
    font-size: var(--t-md);
    line-height: 1.75;
  }

  .prose.w-measure {
    max-width: var(--measure);
  }
  .prose.w-wide {
    max-width: 52rem;
  }
  .prose.w-full {
    max-width: none;
  }

  /* --- Rhythm ---------------------------------------------------- */
  .prose.prose.prose > * + * {
    margin-top: 1.4em;
  }

  .prose.prose.prose > :where(h2) {
    margin-top: 2.2em;
    font-size: var(--t-h3);
  }

  .prose.prose.prose > :where(h3) {
    margin-top: 1.9em;
    font-size: var(--t-xl);
  }

  .prose.prose.prose > :where(h4) {
    margin-top: 1.7em;
    font-family: var(--font-sans);
    font-size: var(--t-base);
    font-weight: var(--w-semibold);
    letter-spacing: 0;
  }

  /* The paragraph after a heading belongs to it. */
  .prose.prose.prose > :where(h2, h3, h4) + * {
    margin-top: 0.7em;
  }

  .prose.prose.prose > :first-child {
    margin-top: 0;
  }

  /* --- Element defaults ------------------------------------------ */
  .prose :where(p, ul, ol, blockquote, pre, table, figure, hr) {
    margin-bottom: 0;
  }

  .prose :where(h2, h3, h4) {
    scroll-margin-top: calc(var(--header-h) + var(--space-5));
  }

  /* Links an author wrote. A link with a class is a component's. */
  .prose :where(a:not([class])) {
    color: var(--blue);
    text-decoration-color: var(--blue-soft);
    text-decoration-thickness: 2px;
  }

  .prose :where(a:not([class])):hover {
    color: var(--blue-strong);
    text-decoration-color: currentColor;
  }

  .prose :where(strong) {
    font-weight: var(--w-semibold);
    color: var(--ink-strong);
  }

  .prose :where(ul, ol) {
    padding-left: 1.4em;
  }

  .prose :where(li + li, li > ul, li > ol) {
    margin-top: 0.4em;
  }

  .prose :where(li)::marker {
    color: var(--blue);
  }

  .prose :where(blockquote) {
    margin-inline: 0;
    padding: 0.25em 0 0.25em 1.25em;
    border-left: 3px solid var(--blue);
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-strong);
  }

  .prose :where(hr) {
    margin-block: 2.5em;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  /* Inline code reads as a token, not a box. */
  .prose :where(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
    background: var(--sand);
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--ink-strong);
  }

  .prose :where(pre) {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-md);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    line-height: 1.65;
    overflow-x: auto;
    box-shadow: var(--shadow-xs);
  }

  .prose :where(img) {
    border-radius: var(--r-lg);
  }

  /* Tables scroll inside themselves rather than widening the page. */
  .prose :where(table) {
    display: block;
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-base);
    overflow-x: auto;
  }

  .prose :where(th, td) {
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--rule-soft);
    text-align: left;
    vertical-align: top;
  }

  .prose :where(th) {
    border-bottom-color: var(--rule);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .prose :where(.footnotes) {
    margin-top: 3em;
    padding-top: 1.5em;
    border-top: 1px solid var(--rule);
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }
</style>
