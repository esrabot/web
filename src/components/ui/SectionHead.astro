---
/**
 * The heading block that opens a section: a small tracked eyebrow, the
 * heading in the display serif, an optional lede, and an optional aside
 * at the far end (a count, a link).
 *
 * The heading is a real heading element so the outline stays correct.
 * Headings are plain text, with no italic or colored accent words. The
 * `title` slot is only for a heading that needs markup (a name on a line
 * of its own); `title` stays the plain-text version.
 */
interface Props {
  /** Plain-text title. Also the fallback when the `title` slot is unused. */
  title: string;
  eyebrow?: string;
  lede?: string;
  /** Heading level. Pick to keep the outline sequential, not for size. */
  as?: 'h2' | 'h3';
  /** `sm` for a sub-section inside a larger one. */
  size?: 'md' | 'sm';
  align?: 'start' | 'center';
  /** id for the heading itself, for aria-labelledby. */
  headingId?: string;
  class?: string;
}

const {
  title,
  eyebrow,
  lede,
  as: Tag = 'h2',
  size = 'md',
  align = 'start',
  headingId,
  class: className,
} = Astro.props;
---

<header class:list={['section-head', `size-${size}`, `align-${align}`, className]}>
  <div class="text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag class="title" id={headingId}>
      {Astro.slots.has('title') ? <slot name="title" /> : title}
    </Tag>
    {lede && <p class="lede">{lede}</p>}
  </div>
  {
    Astro.slots.has('aside') && (
      <div class="aside">
        <slot name="aside" />
      </div>
    )
  }
</header>

<style>
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5) var(--space-7);
    flex-wrap: wrap;
    margin-bottom: var(--space-7);
  }

  .text {
    flex: 1 1 28rem;
    min-width: 0;
  }

  .title {
    margin-top: var(--space-4);
    max-width: 22ch;
    font-size: var(--t-h2);
  }

  /* No eyebrow above it: nothing to stand off from. */
  .title:first-child {
    margin-top: 0;
  }

  .lede {
    margin-top: var(--space-4);
  }

  .size-sm {
    margin-bottom: var(--space-6);
  }

  .size-sm .title {
    max-width: none;
    font-size: var(--t-h3);
  }

  .aside {
    flex: none;
    padding-bottom: 0.375rem;
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .align-center {
    justify-content: center;
    text-align: center;
  }

  .align-center .text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (max-width: 640px) {
    .section-head {
      margin-bottom: var(--space-6);
    }
  }
</style>
