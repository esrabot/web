---
/**
 * A full-bleed horizontal band whose content centers on the page measure.
 * Pairs with SectionHead for the heading block.
 *
 *   tone   `plain` sits on the page; `band` is the light-gray band used to
 *          set one section apart from its neighbors; `white` is a plain
 *          section with a hairline above and below.
 *   pad    vertical room. `flush-top` / `flush-bottom` drop one side, for a
 *          section that continues the one beside it. An anchor link to the
 *          section skips its top padding, so the heading lands under the
 *          header rather than the band's edge.
 *   width  the content measure: the default, `narrow` for reading, `wide`
 *          for wide grids.
 */
interface Props {
  id?: string;
  tone?: 'plain' | 'band' | 'white';
  pad?: 'normal' | 'tight' | 'flush-top' | 'flush-bottom';
  width?: 'default' | 'narrow' | 'wide';
  class?: string;
}

const { id, tone = 'plain', pad = 'normal', width = 'default', class: className } = Astro.props;
---

<section id={id} class:list={['section', `tone-${tone}`, `pad-${pad}`, className]}>
  <div class:list={['container', { narrow: width === 'narrow', wide: width === 'wide' }]}>
    <slot />
  </div>
</section>

<style>
  .section {
    --pad-top: var(--section-y);
    --pad-bottom: var(--section-y);
    position: relative;
    padding-block: var(--pad-top) var(--pad-bottom);
    /* An anchor link lands on the section's heading, not on its top padding. */
    scroll-margin-top: calc(-1 * var(--pad-top));
  }

  .tone-band {
    background: var(--band);
  }

  .tone-white {
    background: var(--surface);
    border-block: 1px solid var(--rule-soft);
  }

  .pad-tight {
    --pad-top: calc(var(--section-y) * 0.6);
    --pad-bottom: calc(var(--section-y) * 0.6);
  }

  /* 0px, not 0: the scroll margin multiplies it and needs a length. */
  .pad-flush-top {
    --pad-top: 0px;
  }

  .pad-flush-bottom {
    --pad-bottom: 0px;
  }
</style>
