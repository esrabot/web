---
/**
 * A full-bleed horizontal band whose content centres on the page measure.
 * Pairs with SectionHead for the heading block.
 *
 *   tone   `plain` sits on the page; `sand` is the beige band used to set
 *          one section apart from its neighbours; `white` is a lifted,
 *          paper-white band.
 *   pad    vertical room. `flush-top` / `flush-bottom` drop one side, for a
 *          section that continues the one beside it.
 *   width  the content measure: the default, `narrow` for reading, `wide`
 *          for wide grids.
 */
interface Props {
  id?: string;
  tone?: 'plain' | 'sand' | 'white';
  pad?: 'normal' | 'tight' | 'flush-top' | 'flush-bottom';
  width?: 'default' | 'narrow' | 'wide';
  class?: string;
}

const { id, tone = 'plain', pad = 'normal', width = 'default', class: className } = Astro.props;
---

<section id={id} class:list={['section', `tone-${tone}`, `pad-${pad}`, className]}>
  <div class:list={['container', { narrow: width === 'narrow', wide: width === 'wide' }]}>
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    padding-block: var(--section-y);
  }

  .tone-sand {
    background: var(--sand);
  }

  .tone-white {
    background: var(--surface);
    border-block: 1px solid var(--rule-soft);
  }

  .pad-tight {
    padding-block: calc(var(--section-y) * 0.6);
  }

  .pad-flush-top {
    padding-top: 0;
  }

  .pad-flush-bottom {
    padding-bottom: 0;
  }
</style>
