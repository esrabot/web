---
/**
 * A pill-shaped link: an icon, a label, and an arrow if it leads away.
 *
 * Used for member profiles, org channels and a project's links. Given a
 * `platform` it takes its icon and label from the registry, so callers
 * never hardcode a platform name.
 */
import { Icon } from 'astro-icon/components';
import { PLATFORM_META, type Platform } from '../../data/orgs';

interface Props {
  href: string;
  /** Pulls the icon and default label from the platform registry. */
  platform?: Platform;
  /** Visible text. Defaults to the platform label. */
  label?: string;
  /** Fill the chip (primary action). */
  solid?: boolean;
  size?: 'sm' | 'base';
  class?: string;
}

const { href, platform, label, solid = false, size = 'base', class: className } = Astro.props;

const meta = platform ? PLATFORM_META[platform] : undefined;
const text = label ?? meta?.label ?? href;

// mailto: and relative links are same-context; only http(s) opens away.
const external = /^https?:/.test(href);
// A handle alone ("@esra") does not say where it goes; name the platform too.
const accessibleName = meta && label ? `${meta.label}: ${label}` : undefined;
---

<a
  href={href}
  class:list={['link-chip', `s-${size}`, { solid }, className]}
  rel={external ? 'noopener' : undefined}
  target={external ? '_blank' : undefined}
  aria-label={accessibleName}
>
  {meta && <Icon name={meta.icon} class="icon" aria-hidden="true" />}
  <span class="text">{text}</span>
  {external && <Icon name="lucide:arrow-up-right" class="out" aria-hidden="true" />}
</a>

<style>
  .link-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    min-height: 2.5rem;
    padding: 0 0.875rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: var(--t-sm);
    font-weight: var(--w-medium);
    color: var(--ink-strong);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .link-chip:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .link-chip:focus-visible {
    border-radius: var(--r-pill);
  }

  .link-chip.solid {
    border-color: var(--blue);
    background: var(--blue);
    color: var(--ink-inverse);
  }

  .link-chip.solid:hover {
    border-color: var(--blue-strong);
    background: var(--blue-strong);
    color: var(--ink-inverse);
  }

  .s-sm {
    min-height: 2rem;
    padding: 0 0.75rem;
    font-size: var(--t-xs);
  }

  .icon,
  .out {
    flex: none;
    width: 1em;
    height: 1em;
  }

  .text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .out {
    opacity: 0.55;
    transition: opacity var(--dur) var(--ease);
  }

  .link-chip:hover .out {
    opacity: 1;
  }
</style>
