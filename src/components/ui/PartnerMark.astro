---
/**
 * A partner's logo, in gray, fitted to a box of a given height and
 * maximum width, so every partner's mark reads at the same size.
 *
 * By default the logo is not shown as an image. Its shape is used as a
 * CSS mask over a block of `currentColor`, so every partner's mark takes
 * the color of the text around it (a mid gray on the partner wall) and
 * follows hover states for free. The mask is generated at build time from
 * the partner's own file (see src/lib/logo-mark.ts).
 *
 * A logo with detail one ink would lose can set `logoMode: grayscale`: it
 * is then shown as the image itself, in gray.
 *
 * A partner with no logo file yet gets a placeholder: its initials in a
 * dashed box, so it is plainly a stand-in and not a logo.
 */
import type { CollectionEntry } from 'astro:content';

import { getPartnerLogoGray, getPartnerMark } from '../../lib/logo-mark';

interface Props {
  partner: CollectionEntry<'partners'>;
  /** Height of the mark, in px. */
  height?: number;
  /** Widest a mark may run, in px. Wide wordmarks shrink to fit. */
  maxWidth?: number;
  /** Decorative: the partner's name is already in text beside the mark. */
  decorative?: boolean;
  class?: string;
}

const {
  partner,
  height = 72,
  maxWidth = height * 2.5,
  decorative = false,
  class: className,
} = Astro.props;
const { name, abbr, logo, logoInvert, logoMode } = partner.data;

const gray = Boolean(logo) && logoMode === 'grayscale';
const mark = logo
  ? await (gray ? getPartnerLogoGray(logo) : getPartnerMark(logo, { invert: logoInvert }))
  : null;

// Fit the mark inside height x maxWidth, keeping its proportions.
const scale = mark ? Math.min(height / mark.height, maxWidth / mark.width) : 1;
const w = mark ? Math.round(mark.width * scale) : 0;
const h = mark ? Math.round(mark.height * scale) : height;

// Placeholder: the abbreviation, or the capitals of the name.
const letters = (abbr ?? name.replace(/[^A-Z]/g, '')).slice(0, 5) || name.slice(0, 2).toUpperCase();
// A box wide enough for the letters, never wider than a real logo may be.
const boxWidth = Math.min(maxWidth, Math.round(height * 1.75));

const a11y = decorative
  ? ({ 'aria-hidden': 'true' } as const)
  : ({ role: 'img', 'aria-label': `${name} logo` } as const);
---

{
  mark && gray ? (
    <img
      class:list={['mark-img', className]}
      src={`/logos/${partner.id}.png`}
      width={w}
      height={h}
      alt={decorative ? '' : `${name} logo`}
      loading="lazy"
      decoding="async"
    />
  ) : mark ? (
    <span
      class:list={['mark', className]}
      style={`--mark: url('/logos/${partner.id}.png'); width: ${w}px; height: ${h}px;`}
      {...a11y}
    />
  ) : (
    <span
      class:list={['mark', 'placeholder', className]}
      style={`width: ${boxWidth}px; height: ${height}px; font-size: ${Math.max(10, Math.round(height * 0.3))}px;`}
      title={`${name}: logo to come`}
      {...a11y}
    >
      {letters}
    </span>
  )
}

<style>
  .mark {
    display: block;
    flex: none;
    max-width: 100%;
    background: currentColor;
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
  }

  /* A grayscale logo, toned to sit with the one-ink marks around it. */
  .mark-img {
    display: block;
    flex: none;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    opacity: 0.8;
    transition: opacity var(--dur) var(--ease);
  }

  :global(a:hover) > .mark-img,
  :global(a:hover) .mark-img {
    opacity: 1;
  }

  /* No logo file yet: initials in a dashed box, plainly a stand-in. */
  .mark.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed currentColor;
    border-radius: var(--r-sm);
    background: none;
    -webkit-mask: none;
    mask: none;
    font-family: var(--font-sans);
    font-weight: var(--w-semibold);
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Forced colors drop backgrounds, which would erase a masked mark. */
  @media (forced-colors: active) {
    .mark:not(.placeholder) {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
</style>
