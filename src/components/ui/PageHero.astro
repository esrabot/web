---
/**
 * The opening of an inner page: eyebrow, the page title, a lede, and an
 * optional row beneath (counts, buttons) from the default slot.
 *
 * It sits on a soft wash — a cool light from one corner, a warm one from
 * the other — that fades into the page, so every inner page opens the
 * same way without a hard-edged banner.
 *
 * For a title with an italic accent word, use the `title` slot.
 */
interface Props {
  eyebrow: string;
  /** Plain-text title. Also the fallback when the `title` slot is unused. */
  title: string;
  lede?: string;
  /** Narrow the block to the reading measure (articles, the 404). */
  narrow?: boolean;
}

const { eyebrow, title, lede, narrow = false } = Astro.props;
---

<section class="page-hero">
  <div class="wash" aria-hidden="true"></div>
  <div class:list={['container', { narrow }]}>
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 data-reveal style="--i: 1">
      {Astro.slots.has('title') ? <slot name="title" /> : title}
    </h1>
    {
      lede && (
        <p class="lede" data-reveal style="--i: 2">
          {lede}
        </p>
      )
    }
    {
      Astro.slots.has('default') && (
        <div class="extra" data-reveal style="--i: 3">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem);
    isolation: isolate;
  }

  .wash {
    position: absolute;
    inset: calc(-1 * var(--header-h)) 0 0;
    z-index: -1;
    background:
      radial-gradient(52rem 26rem at 88% 0%, var(--blue-soft), transparent 62%),
      radial-gradient(44rem 24rem at 4% 8%, var(--sand), transparent 64%);
    -webkit-mask-image: linear-gradient(#000 55%, transparent);
    mask-image: linear-gradient(#000 55%, transparent);
    pointer-events: none;
  }

  h1 {
    margin-top: var(--space-4);
    max-width: 18ch;
    font-size: var(--t-h1);
    font-weight: 480;
    line-height: var(--lh-tight);
    letter-spacing: var(--track-display);
  }

  .lede {
    margin-top: var(--space-5);
  }

  .extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }
</style>
