---
/**
 * The opening of an inner page: eyebrow, the page title, a lede, and an
 * optional row beneath (counts, buttons) from the default slot.
 *
 * Plain white, like the rest of the page: every inner page opens the
 * same way, with no banner, wash or picture behind the title.
 *
 * Titles are plain text, with no italic or colored accent words. The
 * `title` slot is only for a title that needs markup.
 */
interface Props {
  eyebrow: string;
  /** Plain-text title. Also the fallback when the `title` slot is unused. */
  title: string;
  lede?: string;
  /** Narrow the block to the reading measure (articles, the 404). */
  narrow?: boolean;
}

const { eyebrow, title, lede, narrow = false } = Astro.props;
---

<section class="page-hero">
  <div class:list={['container', { narrow }]}>
    <p class="eyebrow">{eyebrow}</p>
    <h1>
      {Astro.slots.has('title') ? <slot name="title" /> : title}
    </h1>
    {lede && <p class="lede">{lede}</p>}
    {
      Astro.slots.has('default') && (
        <div class="extra">
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }

  h1 {
    margin-top: var(--space-3);
    max-width: 22ch;
    font-size: var(--t-h1);
    line-height: var(--lh-tight);
    letter-spacing: var(--track-display);
  }

  .lede {
    margin-top: var(--space-4);
  }

  .extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }
</style>
