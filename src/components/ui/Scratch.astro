---
/**
 * A word scratched out by hand: two pen strokes in the word's own colour,
 * the first left to right, the second back across a little lower.
 *
 *   <em><Scratch>alone</Scratch>.</em>
 *
 * The strokes draw once, when the [data-reveal] block around the word
 * arrives (see global.css). Without script, with reduced motion and in
 * print, the word is simply shown struck out. The strokes are decoration:
 * screen readers and search still get the word itself.
 */
---

<span class="scratch"
  ><slot /><svg class="mark" viewBox="0 0 200 40" aria-hidden="true" focusable="false"
    ><path pathLength="1" d="M4 19 C46 17.5 90 19 132 16.5 S189 14.5 203 14"></path><path
      pathLength="1"
      d="M198 26 C154 27.5 108 30 64 29.5 S16 31 4 31.5"></path></svg
  ></span
>

<style>
  .scratch {
    position: relative;
  }

  /* The word and a hair either side, as a pen overshoots, centred on the
     lowercase letters. The height follows the viewBox, so the strokes
     are never stretched; max-width lifts the global cap on svg, which
     would hold the overshoot in. */
  .mark {
    position: absolute;
    top: calc(50% + 0.1em);
    left: -0.1em;
    width: calc(100% + 0.2em);
    max-width: none;
    height: auto;
    translate: 0 -50%;
    overflow: visible;
    pointer-events: none;
  }

  .mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-linecap: round;
  }

  /* The way back is lighter: the pen is already lifting. */
  .mark path + path {
    stroke-width: 4.2;
  }

  /* Once the block arrives: across, then back. Each stroke is one dash
     the length of its path, held just past the start so no round cap
     shows before the pen comes down. */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.revealed) .mark path {
      stroke-dasharray: 1 2;
      animation: scratch 0.3s var(--ease) 0.6s both;
    }

    :global(.revealed) .mark path + path {
      animation-duration: 0.22s;
      animation-delay: 0.95s;
    }
  }

  @keyframes scratch {
    from {
      stroke-dashoffset: 1.01;
    }

    to {
      stroke-dashoffset: 0;
    }
  }
</style>
