---
/**
 * A figure: a photo in a rounded frame, with an optional corner label
 * and a caption beneath.
 *
 * Images go through astro:assets, so the multi-megabyte source photos
 * ship as sized, modern-format derivatives. Remote or `public/` sources
 * fall back to a plain <img>.
 *
 * Captions accept `**bold**` for the figure number, since that is how
 * authors write them in MDX attributes ("**Figure 1.** Leg test stand.").
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  /** A short label set over the corner of the photo, e.g. "FIG. 1". */
  plate?: string;
  /** A second label, set at the far end of the caption row. */
  ref?: string;
  /** Caption below the photo. Also accepts the `caption` slot. */
  caption?: string;
  ratio?: string;
  fit?: 'cover' | 'contain';
  /** Rendered width hint for the optimiser. */
  width?: number;
  loading?: 'lazy' | 'eager';
  /** Accepted for older posts; photos now print in full colour. */
  dither?: boolean;
  mono?: boolean;
  class?: string;
}

const {
  src,
  alt = '',
  plate,
  ref,
  caption,
  ratio = '4/3',
  fit = 'cover',
  width = 900,
  loading = 'lazy',
  class: className,
} = Astro.props;

const isLocal = typeof src === 'object' && src !== null;
const hasCaption = Boolean(caption) || Astro.slots.has('caption');

// "4/3" -> "4 / 3"; anything unparseable falls back rather than breaking layout.
const [rw, rh] = ratio.split('/').map(Number);
const aspect = rw > 0 && rh > 0 ? `${rw} / ${rh}` : '4 / 3';

const escapeHtml = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// Escaped first, so the only markup in a caption is the <strong> made here.
const captionHtml = caption
  ? escapeHtml(caption).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  : '';
---

<figure class:list={['figure', className]}>
  <div class="frame" style={`aspect-ratio: ${aspect};`}>
    {
      isLocal ? (
        <Image
          src={src as ImageMetadata}
          alt={alt}
          width={width}
          loading={loading}
          class="media"
          style={`object-fit: ${fit};`}
        />
      ) : src ? (
        <img
          src={src as string}
          alt={alt}
          loading={loading}
          decoding="async"
          class="media"
          style={`object-fit: ${fit};`}
        />
      ) : (
        <slot />
      )
    }
    {plate && <span class="plate">{plate}</span>}
  </div>

  {
    (hasCaption || ref) && (
      <figcaption class="caption">
        <span class="caption-text">
          {caption ? <Fragment set:html={captionHtml} /> : <slot name="caption" />}
        </span>
        {ref && <span class="ref">{ref}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 0;
  }

  .frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--sand);
    box-shadow: var(--shadow-sm);
  }

  .media {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plate {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    padding: 0.25rem 0.625rem;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.92);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-strong);
    box-shadow: var(--shadow-xs);
  }

  .caption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .caption :global(strong) {
    font-weight: var(--w-semibold);
    color: var(--ink-strong);
  }

  .ref {
    flex: none;
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
