---
/**
 * Site footer.
 *
 * Opens with a plain closing call to action on white (the partner page
 * first, then the ways in, with the tax status beside them), then the
 * link columns on gray, and a last line of legal and build facts.
 *
 * Channel columns come from the org registry, so an account appears here
 * or does not exist.
 */
import Logo from '../ui/Logo.astro';
import { CONTACTS, JOIN_HREF, NAV, PARTNER_HREF, SITE, buildInfo } from '../../data/site';
import { ORGS, PLATFORM_META } from '../../data/orgs';

interface Props {
  /** Drop the closing call to action (pages that end on their own). */
  cta?: boolean;
}

const { cta = true } = Astro.props;

const general = CONTACTS[0];
const build = buildInfo();
const year = new Date().getFullYear();
---

<footer class="footer">
  {
    cta && (
      <section class="cta" aria-labelledby="footer-cta">
        <div class="container cta-row">
          <div class="cta-copy">
            <p class="eyebrow">Get involved</p>
            <h2 id="footer-cta">Robots no single campus could build alone.</h2>
            <p class="cta-tax">{SITE.taxNote}</p>
          </div>
          <div class="cta-actions">
            <a class="btn" href={PARTNER_HREF}>
              Partner with us
            </a>
            <a class="btn secondary" href={JOIN_HREF}>
              Get involved
            </a>
          </div>
        </div>
      </section>
    )
  }

  <div class="base">
    <div class="container">
      <div class="cols">
        <div class="about">
          <a href="/" class="brand" aria-label={`${SITE.name} home`}>
            <Logo height={24} label={null} />
          </a>
          <p class="blurb">{SITE.description}</p>
          <a class="mail" href={`mailto:${general.address}`}>{general.address}</a>
        </div>

        <nav class="col" aria-label="Site">
          <h2 class="col-head">Explore</h2>
          <ul>
            {
              NAV.map(({ label, href }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))
            }
            <li><a href="/search">Search</a></li>
          </ul>
        </nav>

        <nav class="col" aria-label="Resources">
          <h2 class="col-head">Resources</h2>
          <ul>
            <li><a href="/contact">Contact</a></li>
            <li><a href={SITE.orgUrl} rel="noopener">GitHub</a></li>
            <li><a href={SITE.repoUrl} rel="noopener">This site’s source</a></li>
            <li><a href="/colophon">Colophon</a></li>
          </ul>
        </nav>

        {
          ORGS.map((org) => (
            <nav class="col" aria-label={`${org.name} channels`}>
              <h2 class="col-head">{org.name}</h2>
              <ul>
                {org.links
                  .filter((l) => l.platform !== 'website' || org.id !== 'esra')
                  .map((link) => (
                    <li>
                      <a href={link.url} rel="noopener">
                        {PLATFORM_META[link.platform].label}
                      </a>
                    </li>
                  ))}
              </ul>
            </nav>
          ))
        }
      </div>

      <div class="fine">
        <p>{`© ${year} ${SITE.fullName} · ${SITE.incorporated} · ${SITE.taxStatus}`}</p>
        <p>
          Designs released under {SITE.license} &middot;{' '}
          {
            build.sha ? (
              <a href={build.commitUrl} rel="noopener">
                build {build.sha}
              </a>
            ) : (
              <span>built {build.date}</span>
            )
          }
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-y);
  }

  /* A page that ends on a gray band already has its break: no white gap
     between the band and the closing section. */
  :global(main:has(> .tone-band:last-child)) + .footer {
    margin-top: 0;
  }

  /* --- the closing call to action ---------------------------------- */
  .cta {
    border-top: 1px solid var(--rule);
  }

  .cta-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    padding-block: var(--space-8);
  }

  .cta-copy {
    flex: 1 1 26rem;
    min-width: 0;
  }

  .cta h2 {
    margin-top: var(--space-3);
    max-width: 24ch;
    font-size: var(--t-h2);
  }

  .cta-tax {
    margin: var(--space-3) 0 0;
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* --- link columns ---------------------------------------------- */
  .base {
    border-top: 1px solid var(--band-edge);
    background: var(--band);
    padding-block: var(--space-8) var(--space-6);
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
  }

  .brand {
    display: inline-flex;
    color: var(--ink-strong);
    text-decoration: none;
  }

  .blurb {
    max-width: 22rem;
    margin: var(--space-4) 0 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-body);
  }

  .mail {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-strong);
  }

  .mail:hover {
    color: var(--blue);
  }

  .col-head {
    margin: 0 0 var(--space-3);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .col ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .col a {
    display: inline-block;
    padding: 0.25rem 0;
    font-size: var(--t-sm);
    color: var(--ink-body);
    text-decoration: none;
  }

  .col a:hover {
    color: var(--blue);
    text-decoration: underline;
  }

  /* --- last line ------------------------------------------------- */
  .fine {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--band-edge);
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .fine p {
    margin: 0;
  }

  .fine a {
    color: inherit;
  }

  .fine a:hover {
    color: var(--blue);
  }

  @media (max-width: 1000px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .cta-row {
      padding-block: var(--space-7);
    }

    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-5);
    }

    .cta-actions,
    .cta-actions .btn {
      width: 100%;
    }
  }
</style>
