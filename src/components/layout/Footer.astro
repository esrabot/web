---
/**
 * Site footer.
 *
 * Opens with the closing call to action — one blue band, the only large
 * block of saturated colour on a page — then the link columns on beige,
 * a last line of legal and build facts, and to close, the ESRA
 * wordmark set solid across the full width.
 *
 * Channel columns come from the org registry, so an account appears here
 * or does not exist.
 */
import { Icon } from 'astro-icon/components';

import Logo from '../ui/Logo.astro';
import { CONTACTS, JOIN_HREF, NAV, SITE, buildInfo } from '../../data/site';
import { ORGS, PLATFORM_META } from '../../data/orgs';

interface Props {
  /** Drop the call-to-action band (pages that end on their own). */
  cta?: boolean;
}

const { cta = true } = Astro.props;

const general = CONTACTS[0];
const build = buildInfo();
const year = new Date().getFullYear();
---

<footer class="footer">
  {
    cta && (
      <div class="container cta-wrap">
        <section class="cta-band" aria-labelledby="footer-cta">
          <div class="cta-glow" aria-hidden="true" />
          <div class="cta-copy">
            <p class="eyebrow">Get involved</p>
            <h2 id="footer-cta">Robots no single campus could build alone.</h2>
          </div>
          <div class="cta-actions">
            <a class="btn lg on-blue" href={JOIN_HREF}>
              Get involved <Icon name="lucide:arrow-right" class="arrow" aria-hidden="true" />
            </a>
            <a class="btn lg on-blue outline" href="/contact">
              Contact us
            </a>
          </div>
        </section>
      </div>
    )
  }

  <div class:list={['base', { 'has-cta': cta }]}>
    <div class="container">
      <div class="cols">
        <div class="about">
          <a href="/" class="brand" aria-label={`${SITE.name} home`}>
            <Logo height={26} label={null} />
          </a>
          <p class="blurb">{SITE.description}</p>
          <a class="mail" href={`mailto:${general.address}`}>
            <Icon name="lucide:mail" aria-hidden="true" />
            {general.address}
          </a>
        </div>

        <nav class="col" aria-label="Site">
          <h2 class="col-head">Explore</h2>
          <ul>
            {
              NAV.map(({ label, href }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))
            }
            <li><a href="/search">Search</a></li>
          </ul>
        </nav>

        <nav class="col" aria-label="Resources">
          <h2 class="col-head">Resources</h2>
          <ul>
            <li><a href="/contact">Contact</a></li>
            <li><a href={SITE.orgUrl} rel="noopener">GitHub</a></li>
            <li><a href={SITE.repoUrl} rel="noopener">This site’s source</a></li>
            <li><a href="/colophon">Colophon</a></li>
          </ul>
        </nav>

        {
          ORGS.map((org) => (
            <nav class="col" aria-label={`${org.name} channels`}>
              <h2 class="col-head">{org.name}</h2>
              <ul>
                {org.links
                  .filter((l) => l.platform !== 'website' || org.id !== 'esra')
                  .map((link) => (
                    <li>
                      <a href={link.url} rel="noopener">
                        {PLATFORM_META[link.platform].label}
                      </a>
                    </li>
                  ))}
              </ul>
            </nav>
          ))
        }
      </div>

      <div class="fine">
        <p>{`© ${year} ${SITE.fullName} · ${SITE.incorporated} · ${SITE.taxStatus}`}</p>
        <p>
          Designs released under {SITE.license} &middot;{' '}
          {
            build.sha ? (
              <a href={build.commitUrl} rel="noopener">
                build {build.sha}
              </a>
            ) : (
              <span>built {build.date}</span>
            )
          }
        </p>
      </div>

      <div class="wordmark" aria-hidden="true">
        <Logo label={null} tight />
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-y);
  }

  /* --- the call to action --------------------------------------- */
  .cta-wrap {
    position: relative;
    z-index: 1;
  }

  .cta-band {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6) var(--space-7);
    flex-wrap: wrap;
    padding: clamp(2.25rem, 6vw, 4.5rem);
    border-radius: var(--r-xl);
    background: linear-gradient(
      125deg,
      var(--blue) 0%,
      var(--blue-strong) 55%,
      var(--blue-deep) 100%
    );
    color: var(--ink-inverse);
    box-shadow: var(--shadow-blue);
    overflow: hidden;
    isolation: isolate;
  }

  /* Two soft lights behind the copy: one warm, one cool. */
  .cta-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(38rem 22rem at 100% 0%, rgba(243, 235, 220, 0.3), transparent 60%),
      radial-gradient(30rem 20rem at 0% 100%, rgba(185, 205, 251, 0.28), transparent 60%);
    pointer-events: none;
  }

  .cta-copy {
    flex: 1 1 26rem;
    min-width: 0;
  }

  .cta-band .eyebrow {
    color: var(--blue-on-dark);
  }

  .cta-band h2 {
    margin-top: var(--space-4);
    max-width: 18ch;
    font-size: var(--t-h2);
    color: var(--ink-inverse);
  }

  .cta-band h2 em {
    color: var(--band);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* --- link columns ---------------------------------------------- */
  .base {
    border-top: 1px solid var(--band-edge);
    background: var(--band);
    padding-block: var(--space-8) var(--space-6);
  }

  /* The band straddles the top edge of the beige. */
  .base.has-cta {
    margin-top: calc(-1 * clamp(3rem, 8vw, 5.5rem));
    padding-top: calc(clamp(3rem, 8vw, 5.5rem) + var(--space-8));
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
  }

  .brand {
    display: inline-flex;
    color: var(--ink-strong);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .brand:hover {
    color: var(--blue);
  }

  .blurb {
    max-width: 22rem;
    margin: var(--space-4) 0 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-body);
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-4);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-strong);
    text-decoration: none;
  }

  .mail:hover {
    color: var(--blue);
  }

  .mail :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .col-head {
    margin: 0 0 var(--space-3);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .col ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The underline is ruled in from the left under the pointer. */
  .col a {
    display: inline-block;
    padding: 0.25rem 0;
    font-size: var(--t-sm);
    color: var(--ink-body);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 calc(100% - 0.2rem) / 0 1px;
    transition:
      color var(--dur) var(--ease),
      background-size var(--dur-slow) var(--ease-out);
  }

  .col a:hover {
    color: var(--blue);
    background-size: 100% 1px;
  }

  /* --- last line ------------------------------------------------- */
  .fine {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--band-edge);
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .fine p {
    margin: 0;
  }

  .fine a {
    color: inherit;
  }

  .fine a:hover {
    color: var(--blue);
  }

  /* --- the wordmark ---------------------------------------------- */
  /* Last thing on the page: the wordmark set solid, edge to edge
     across the columns. */
  .wordmark {
    margin-top: var(--space-7);
    color: var(--ink-strong);
  }

  .wordmark :global(svg) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 1000px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-5);
    }

    .cta-actions,
    .cta-actions .btn {
      width: 100%;
    }
  }
</style>
