---
/**
 * A guide. Uses the shared MDX vocabulary in components/blog.
 */
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Article from '../../components/ui/Article.astro';
import { mdxComponents } from '../../components/blog';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).filter((d) => import.meta.env.DEV || !d.data.draft);
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const eyebrow = ['Guide', doc.data.duration].filter(Boolean).join(' · ');
---

<BaseLayout title={doc.data.title} description={doc.data.description ?? doc.data.title}>
  <Article
    eyebrow={eyebrow}
    title={doc.data.title}
    lede={doc.data.description}
    back={{ href: '/docs', label: 'All guides' }}
  >
    <Content components={mdxComponents} />
  </Article>
</BaseLayout>
