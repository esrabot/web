---
/**
 * Contact — the mailboxes and channels a reader can actually reach.
 *
 * Addresses come from the CONTACTS registry in data/site.ts, channels from
 * the org registry in data/orgs.ts, so this page never hardcodes an address
 * or a social URL: it shows exactly what exists and nothing that doesn't.
 */
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import { CONTACTS, JOIN_HREF } from '../data/site';
import { ORGS, PLATFORM_META } from '../data/orgs';

// An address may only break before its "@", never inside a word.
const mailboxes = CONTACTS.map((c) => {
  const at = c.address.indexOf('@');
  return { ...c, local: c.address.slice(0, at), domain: c.address.slice(at) };
});
---

<BaseLayout title="Contact" description="How to reach ESRA — email, and where we post.">
  <PageHero
    eyebrow="Contact"
    title="Say hello."
    lede="Email is best, and it is read by people rather than a bot. For build logs and day-to-day updates, the channels below are where they land first."
  >
    <Fragment slot="title">Say <em>hello.</em></Fragment>
    <a class="btn" href={`mailto:${CONTACTS[0].address}`}>
      <Icon name="lucide:mail" aria-hidden="true" />
      {CONTACTS[0].address}
    </a>
    <a class="btn secondary" href={JOIN_HREF}>Ways to get involved</a>
  </PageHero>

  <Section pad="flush-top">
    <SectionHead eyebrow="Email" title="Write to the right inbox" />
    <div class="mailboxes">
      {
        mailboxes.map((c, i) => (
          <a class="mailbox card lift" href={`mailto:${c.address}`}>
            <span class="mb-icon" aria-hidden="true">
              <Icon name="lucide:mail" />
            </span>
            <span class="mb-label">{c.label}</span>
            <span class="mb-addr">
              {c.local}
              <wbr />
              {c.domain}
            </span>
            <span class="mb-note">{c.note}</span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section tone="sand" pad="tight">
    <SectionHead
      eyebrow="Channels"
      title="Where we post"
      lede="Every account here is real and ours. If a platform is missing, we are not on it."
    />
    <div class="orgs">
      {
        ORGS.map((org, i) => (
          <section class="org card">
            <h3>{org.name}</h3>
            {org.blurb && <p class="org-blurb">{org.blurb}</p>}
            <ul>
              {org.links.map((link) => (
                <li>
                  {/* Off-site links get their new tab from src/middleware.ts. */}
                  <a href={link.url}>
                    <Icon name={PLATFORM_META[link.platform].icon} aria-hidden="true" />
                    <span class="ch-label">{PLATFORM_META[link.platform].label}</span>
                    {link.handle && <span class="ch-handle">{link.handle}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Section>
</BaseLayout>

<style>
  /* Four inboxes: one row of four, two rows of two, then one column, so
     no inbox is ever left alone on a row. */
  .mailboxes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 1180px) {
    .mailboxes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .mailboxes {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .mailbox {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    color: var(--ink-strong);
    text-decoration: none;
  }

  .mailbox:hover {
    color: var(--ink-strong);
  }

  .mb-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-md);
    background: var(--blue-wash);
    color: var(--blue);
    transition:
      background-color var(--dur-slow) var(--ease),
      color var(--dur-slow) var(--ease);
  }

  .mb-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .mailbox:hover .mb-icon {
    background: var(--blue);
    color: var(--ink-inverse);
  }

  .mb-label {
    margin-top: var(--space-5);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue);
  }

  .mb-addr {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 560;
    letter-spacing: var(--track-tight);
    overflow-wrap: anywhere;
    transition: color var(--dur) var(--ease);
  }

  .mailbox:hover .mb-addr {
    color: var(--blue);
  }

  .mb-note {
    margin-top: var(--space-2);
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .orgs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
    gap: var(--space-5);
  }

  .org {
    padding: var(--space-6);
  }

  .org h3 {
    font-size: var(--t-h3);
  }

  .org-blurb {
    margin: var(--space-2) 0 0;
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .org ul {
    margin: var(--space-4) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-soft);
    list-style: none;
  }

  .org a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline: calc(-1 * var(--space-3));
    padding: 0.625rem var(--space-3);
    border-bottom: 1px solid var(--rule-soft);
    border-radius: var(--r-sm);
    color: var(--ink-strong);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .org li:last-child a {
    border-bottom: 0;
  }

  .org a:hover {
    background: var(--blue-wash);
    color: var(--blue-strong);
  }

  .org a :global(svg) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  .ch-label {
    font-weight: var(--w-medium);
  }

  .ch-handle {
    min-width: 0;
    margin-left: auto;
    overflow: hidden;
    font-size: var(--t-sm);
    color: var(--ink-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
