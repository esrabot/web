---
/**
 * Events.
 *
 * Two layers, on purpose:
 *
 *   - The few big events get a card each, written by hand in
 *     src/content/events.yaml. Featured ones get the large card.
 *   - Everything else — work sessions, meetings, deadlines — lives in the
 *     public Google Calendar embedded below, so adding a date never needs
 *     a deploy.
 *
 * Between them, "on the horizon" lists the flagship's milestones, read
 * from the same programme record the home page's schedule uses, and a
 * short strip says what ESRA publishes and how often.
 *
 * Whether an event reads as upcoming, happening now, or past is worked
 * out from its dates at build time; the scheduled rebuild keeps it true.
 * An event marked `tentative` has no final date yet: it always reads as
 * upcoming, and shows its `when` text in place of the month and year.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import { CALENDAR, CONTACTS } from '../data/site';
import { requireAsset } from '../lib/assets';

const [allEvents, allPrograms] = await Promise.all([
  getCollection('events'),
  getCollection('programs'),
]);

const now = new Date();
const DAY = 86_400_000;

type Phase = 'now' | 'upcoming' | 'past';
const PHASE_LABEL: Record<Phase, string> = {
  now: 'Happening now',
  upcoming: 'Upcoming',
  past: 'Past',
};
// On now first, then what is coming (soonest first), then what has been.
const PHASE_ORDER: Record<Phase, number> = { now: 0, upcoming: 1, past: 2 };

const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });

const DATE_TBC = 'Date to be confirmed';

/**
 * A tentative event's `when`, split for the two-line date block the way
 * a month sits over its year: "Winter" over "2026–27", "Early" over
 * "2027", "Mid" over "2027".
 */
const splitWhen = (when: string): [string, string] => {
  const parts = when.match(/^(\S+?)[\s-]+(\S.*)$/);
  return parts ? [parts[1]!, parts[2]!] : [when, ''];
};

const events = allEvents
  .filter((e) => !e.data.draft)
  .map((e) => {
    const start = e.data.start.getTime();
    // An event's last day counts in full.
    const end = (e.data.end ?? e.data.start).getTime() + DAY;
    // A date that is not final never claims to be on now, or over.
    const phase: Phase = e.data.tentative
      ? 'upcoming'
      : now.getTime() < start
        ? 'upcoming'
        : now.getTime() < end
          ? 'now'
          : 'past';
    const [dateTop, dateBottom] = e.data.tentative
      ? splitWhen(e.data.when)
      : [monthFmt.format(e.data.start), String(e.data.start.getUTCFullYear())];
    return {
      ...e.data,
      id: e.id,
      phase,
      dateTop,
      dateBottom,
      photo: e.data.image ? requireAsset(e.data.image, `events.yaml: ${e.id}`) : null,
    };
  })
  .sort((a, b) => {
    if (a.phase !== b.phase) return PHASE_ORDER[a.phase] - PHASE_ORDER[b.phase];
    const diff = a.start.getTime() - b.start.getTime();
    return a.phase === 'past' ? -diff : diff;
  });

const featured = events.filter((e) => e.featured);
const others = events.filter((e) => !e.featured);

/* --- On the horizon: the flagship's milestones ---------------------- */
const flagship = allPrograms.find((p) => p.data.flagship);
const milestones = flagship?.data.milestones ?? [];
const currentMilestone = milestones.findLastIndex((m) => m.starts <= now);

/* --- What we publish ------------------------------------------------ */
const PUBLISH = [
  { output: 'Newsletter', often: 'Twice a week' },
  { output: 'Researcher and engineer blog', often: 'Monthly' },
  { output: 'Progress posts', often: 'Twice a month' },
  { output: 'Progress reports', often: 'December, March and at H1’s completion' },
];

const general = CONTACTS[0].address;
const hostMail = `mailto:${general}?subject=${encodeURIComponent('An event for the ESRA calendar')}`;

const isInternal = (url: string) => url.startsWith('/') || url.startsWith('#');
---

<BaseLayout
  title="Events"
  description="Featured ESRA events, the H1 roadmap, and the public calendar you can subscribe to."
>
  <PageHero
    eyebrow="Events"
    title="Where the network meets."
    lede="Build milestones, integration sessions, and everything else on the ESRA calendar — with a feed you can add to your own."
  >
    <a class="btn" href="#calendar">
      <Icon name="lucide:calendar-days" aria-hidden="true" />
      Open the calendar
    </a>
    <a class="btn secondary" href={CALENDAR.googleUrl} rel="noopener" target="_blank">
      <Icon name="lucide:calendar-plus" aria-hidden="true" />
      Add to Google Calendar
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </PageHero>

  <!-- ============================================================
       Featured
       ============================================================ -->
  <Section id="featured" pad="tight">
    <SectionHead eyebrow="Featured" title="The big ones" />

    {
      featured.length === 0 ? (
        <p class="empty card">
          Nothing is featured right now. The <a href="#calendar">calendar</a> below has every date.
        </p>
      ) : (
        <div class="features">
          {featured.map((e) => (
            <article id={e.id} class="feature card">
              <div class:list={['feature-date', { 'has-photo': e.photo }]}>
                {e.photo && (
                  <Image src={e.photo} alt={e.imageAlt ?? ''} width={720} class="feature-photo" />
                )}
                <span class="feature-chips">
                  <span class:list={['chip', { solid: e.phase === 'now' }]}>
                    {e.phase === 'now' && <span class="pulse" aria-hidden="true" />}
                    {PHASE_LABEL[e.phase]}
                  </span>
                  {e.tentative && <span class="chip outline">{DATE_TBC}</span>}
                </span>
                <p class:list={['date-big', { tbc: e.tentative }]} aria-hidden="true">
                  <span class="date-month">{e.dateTop}</span>
                  <span class="date-year">{e.dateBottom}</span>
                </p>
              </div>

              <div class="feature-body">
                {e.kicker && <p class="eyebrow plain">{e.kicker}</p>}
                <h3>{e.title}</h3>

                <dl class="facts">
                  <div>
                    <dt>When</dt>
                    <dd>{e.when}</dd>
                  </div>
                  {e.location && (
                    <div>
                      <dt>Where</dt>
                      <dd>{e.location}</dd>
                    </div>
                  )}
                  {e.format && (
                    <div>
                      <dt>Format</dt>
                      <dd>{e.format}</dd>
                    </div>
                  )}
                </dl>

                <p class="feature-summary">{e.summary}</p>

                {e.highlights.length > 0 && (
                  <ul class="highlights">
                    {e.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}

                {e.links.length > 0 && (
                  <div class="feature-actions">
                    {e.links.map((l, n) => (
                      <a
                        class:list={['btn', { secondary: n > 0 }]}
                        href={l.url}
                        rel={isInternal(l.url) ? undefined : 'noopener'}
                        target={isInternal(l.url) ? undefined : '_blank'}
                      >
                        {l.label}
                        {n === 0 && (
                          <Icon name="lucide:arrow-right" class="arrow" aria-hidden="true" />
                        )}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      others.length > 0 && (
        <div class="more">
          <SectionHead as="h3" size="sm" eyebrow="Also" title="More events" />
          <ul class="more-list">
            {others.map((e) => (
              <li id={e.id} class="more-item card">
                <p class:list={['more-date', { tbc: e.tentative }]} aria-hidden="true">
                  <span>{e.dateTop}</span>
                  <span>{e.dateBottom}</span>
                </p>
                <div class="more-body">
                  <p class="more-when">
                    {e.when}
                    {e.location && <> · {e.location}</>}
                  </p>
                  <h4>{e.title}</h4>
                  {e.kicker && <p class="more-kicker">{e.kicker}</p>}
                  <p>{e.summary}</p>
                  {e.highlights.length > 0 && (
                    <ul class="more-highlights">
                      {e.highlights.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  )}
                  {e.links[0] && (
                    <a
                      class="link-arrow"
                      href={e.links[0].url}
                      rel={isInternal(e.links[0].url) ? undefined : 'noopener'}
                      target={isInternal(e.links[0].url) ? undefined : '_blank'}
                    >
                      {e.links[0].label} <Icon name="lucide:arrow-right" aria-hidden="true" />
                    </a>
                  )}
                </div>
                <div class="more-chips">
                  <span class:list={['chip', { solid: e.phase === 'now' }]}>
                    {PHASE_LABEL[e.phase]}
                  </span>
                  {e.tentative && <span class="chip outline">{DATE_TBC}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </Section>

  <!-- ============================================================
       On the horizon
       ============================================================ -->
  {
    flagship && milestones.length > 0 && (
      <Section id="horizon" pad="tight">
        <SectionHead
          eyebrow={`${flagship.data.designation ?? flagship.data.title} roadmap`}
          title="On the horizon"
          lede="The milestones the flagship build is working toward. Dates firm up as each one gets closer — the calendar below always has the latest."
        >
          <a slot="aside" class="link-arrow" href="/#h1">
            About {flagship.data.designation ?? flagship.data.title}
            <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
        </SectionHead>

        <ol class="horizon">
          {milestones.map((m, i) => (
            <li
              class:list={[
                'stage',
                'card',
                { done: i < currentMilestone, current: i === currentMilestone },
              ]}
            >
              <p class="stage-top">
                <span class="stage-no" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {i === currentMilestone && (
                  <span class="chip solid">
                    <span class="pulse" aria-hidden="true" />
                    Now
                  </span>
                )}
                {i < currentMilestone && <span class="chip">Done</span>}
              </p>
              <p class="stage-when">{m.when}</p>
              <h3>{m.title}</h3>
              <p class="stage-body">{m.body}</p>
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  <!-- ============================================================
       What we publish
       ============================================================ -->
  <Section id="publish" pad="tight">
    <SectionHead size="sm" eyebrow="Updates" title="What we publish" />
    <dl class="publish">
      {
        PUBLISH.map((p) => (
          <div class="pub card">
            <dt>{p.output}</dt>
            <dd>{p.often}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- ============================================================
       The calendar
       ============================================================ -->
  <Section id="calendar" tone="band">
    <SectionHead
      eyebrow="Calendar"
      title="Every date, in one place."
      lede="Workshops, work sessions, and deadlines all land on the public ESRA calendar. Subscribe once and they show up in yours."
    />

    <div class="cal">
      <div class="cal-frame card">
        <iframe
          id="esra-calendar"
          src={CALENDAR.embedUrl('MONTH')}
          data-agenda-src={CALENDAR.embedUrl('AGENDA')}
          title="ESRA events calendar"
          loading="lazy"></iframe>
        <!-- A month grid is unreadable on a phone: swap to the agenda
             view there. Runs straight after the iframe is parsed, and the
             iframe is lazy, so on most pages nothing has loaded yet. -->
        <script is:inline>
          (function () {
            var frame = document.getElementById('esra-calendar');
            var agenda = frame && frame.getAttribute('data-agenda-src');
            if (agenda && window.matchMedia('(max-width: 640px)').matches) frame.src = agenda;
          })();
        </script>
      </div>

      <aside class="cal-side card" aria-labelledby="subscribe-title">
        <h3 id="subscribe-title">Subscribe</h3>
        <p>Add the ESRA calendar to the one you already use. New dates appear on their own.</p>

        <div class="cal-actions">
          <a class="btn" href={CALENDAR.googleUrl} rel="noopener" target="_blank">
            <Icon name="lucide:calendar-plus" aria-hidden="true" />
            Google Calendar
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="btn secondary" href={CALENDAR.webcalUrl}>
            <Icon name="lucide:calendar-days" aria-hidden="true" />
            Apple Calendar or Outlook
          </a>
        </div>

        <div class="ical">
          <label for="ical-url">iCal feed, for any other app</label>
          <div class="ical-row">
            <input id="ical-url" type="text" readonly value={CALENDAR.icalUrl} data-ical-input />
            <button type="button" class="copy" data-ical-copy>
              <span class="copy-idle">
                <Icon name="lucide:copy" aria-hidden="true" />
                Copy
              </span>
              <span class="copy-done" aria-hidden="true">
                <Icon name="lucide:check" />
                Copied
              </span>
            </button>
          </div>
          <p class="sr-only" role="status" aria-live="polite" data-ical-status></p>
        </div>

        <p class="cal-note">
          <Icon name="lucide:clock" aria-hidden="true" />
          <span>Times are shown in {CALENDAR.timezoneLabel}.</span>
        </p>
        <a class="link-arrow out" href={CALENDAR.publicUrl} rel="noopener" target="_blank">
          Open the full calendar <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </aside>
    </div>

    <p class="host">
      Hosting something the network should know about?{' '}
      <a href={hostMail}>Email {general}</a>.
    </p>
  </Section>
</BaseLayout>

<script>
  // Copy the iCal feed's address. The field is a real, selectable input,
  // so where the clipboard is unavailable the address is selected for the
  // visitor to copy by hand instead.
  const input = document.querySelector<HTMLInputElement>('[data-ical-input]');
  const button = document.querySelector<HTMLButtonElement>('[data-ical-copy]');
  const status = document.querySelector<HTMLElement>('[data-ical-status]');

  if (input && button) {
    let reset = 0;

    // Clicking into the field selects the whole address.
    input.addEventListener('focus', () => input.select());

    button.addEventListener('click', async () => {
      let copied = false;
      try {
        await navigator.clipboard.writeText(input.value);
        copied = true;
      } catch {
        input.focus();
        input.select();
      }

      if (status) {
        status.textContent = copied
          ? 'Calendar link copied.'
          : 'Copying is unavailable here. The link is selected — copy it from the field.';
      }
      if (!copied) return;

      button.setAttribute('data-copied', '');
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.removeAttribute('data-copied');
        if (status) status.textContent = '';
      }, 2200);
    });
  }
</script>

<style>
  /* ================================================================
   * Featured
   * ============================================================== */
  .features {
    display: grid;
    gap: var(--space-5);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.7fr);
    overflow: hidden;
  }

  .feature:target,
  .more-item:target {
    border-color: var(--blue);
    box-shadow: 0 0 0 1px var(--blue);
  }

  /* The date, set large on a gray panel. */
  .feature-date {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-7);
    min-height: 14rem;
    padding: var(--space-6);
    border-right: 1px solid var(--rule);
    background: var(--band);
    color: var(--ink-strong);
    overflow: hidden;
    isolation: isolate;
  }

  .feature-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* Over a photo, a dark veil keeps the lettering legible. */
  .feature-date.has-photo {
    color: var(--ink-inverse);
  }

  .feature-date.has-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(15, 29, 53, 0.62);
  }

  .feature-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .date-big {
    display: grid;
    margin: 0;
    font-family: var(--font-display);
    line-height: 1;
    letter-spacing: var(--track-display);
  }

  .date-month {
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    font-weight: var(--w-semibold);
  }

  .date-year {
    margin-top: var(--space-1);
    font-size: var(--t-xl);
    font-weight: var(--w-semibold);
    letter-spacing: 0;
    opacity: 0.72;
  }

  /* A season is a longer word than a month: set it a step smaller. */
  .date-big.tbc .date-month {
    font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3rem);
  }

  .feature-body {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .feature h3 {
    margin-top: var(--space-3);
    font-size: var(--t-h2);
  }

  .feature h3:first-child {
    margin-top: 0;
  }

  /* When, where and in what format, each under a small label. */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-4) 0 0;
  }

  .facts dt {
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .facts dd {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: var(--w-medium);
    color: var(--ink-strong);
  }

  .feature-summary {
    max-width: var(--measure);
    margin: var(--space-5) 0 0;
    font-size: var(--t-md);
    color: var(--ink-body);
  }

  .highlights,
  .more-highlights {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0 0 0 1.125rem;
  }

  .highlights li,
  .more-highlights li {
    padding-left: 0.125rem;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  .highlights li::marker,
  .more-highlights li::marker {
    color: var(--ink-faint);
  }

  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .empty {
    max-width: var(--measure);
    margin: 0;
    padding: var(--space-6);
    color: var(--ink-body);
  }

  .empty a {
    color: var(--blue);
  }

  /* --- more events ------------------------------------------------- */
  .more {
    margin-top: var(--space-8);
  }

  .more-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more-item {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .more-date {
    display: grid;
    justify-items: center;
    margin: 0;
    padding: var(--space-3) 0;
    border: 1px solid var(--band-edge);
    border-radius: var(--r-md);
    background: var(--band);
    color: var(--ink-strong);
    line-height: 1.15;
  }

  .more-date span:first-child {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: var(--w-semibold);
  }

  .more-date span:last-child {
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
  }

  /* Not a fixed date yet: the badge is drawn in dashes, and the season
     ("Winter") is set a step smaller than a month would be, to fit. */
  .more-date.tbc {
    border: 1px dashed var(--rule-strong);
    background: var(--surface);
  }

  .more-date.tbc span:first-child {
    font-size: var(--t-lg);
  }

  .more-highlights {
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .more-highlights li {
    font-size: var(--t-sm);
    line-height: 1.55;
  }

  .more-chips {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
  }

  .more-when {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-muted);
  }

  .more-item h4 {
    margin-top: var(--space-1);
    font-size: var(--t-xl);
  }

  .more-body p:not(.more-when) {
    margin: var(--space-2) 0 0;
    color: var(--ink-body);
  }

  .more-body p.more-kicker {
    margin-top: var(--space-1);
    font-size: var(--t-sm);
    font-weight: var(--w-medium);
    color: var(--ink-muted);
  }

  .more-body .link-arrow {
    margin-top: var(--space-3);
    font-size: var(--t-sm);
  }

  /* ================================================================
   * On the horizon
   * ============================================================== */
  .horizon {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stage {
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .stage.current {
    border-color: var(--blue);
  }

  .stage-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.5rem;
    margin: 0;
  }

  .stage-no {
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .stage.current .stage-no {
    color: var(--ink-strong);
  }

  .stage-when {
    margin: var(--space-5) 0 0;
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-muted);
  }

  .stage h3 {
    margin-top: var(--space-1);
    font-size: var(--t-xl);
  }

  .stage-body {
    margin: var(--space-2) 0 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-body);
  }

  /* ================================================================
   * What we publish
   * ============================================================== */
  .publish {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
  }

  /* How often, set large; what it is, underneath. */
  .pub {
    display: flex;
