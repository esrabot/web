---
/**
 * Projects.
 *
 * From the broadest view down to the code:
 *
 *   1. Project areas — what ESRA projects can involve.
 *   2. The roadmap — the robots ESRA is building or has committed to
 *      build (src/content/programs.yaml).
 *   3. Inside H1 — how the flagship is built across universities, and
 *      what happens at an integration session.
 *   4. From the workshop — builds written up in full, each with a page of
 *      its own (src/content/projects/*.md).
 *   5. Open documentation — what every release includes, the reports,
 *      and the Industry Research Alliance to come.
 *   6. Recent activity — hand-picked posts and links from
 *      src/content/featured.yaml, when there are any.
 *   7. Repositories — generated from the org's real repositories, so the
 *      list stays current with no hand-maintenance. Most recently updated
 *      first; it shows the first eight, and a button brings in the rest.
 *
 * A markdown file in src/content/projects can also enrich a repository's
 * card (a better title or summary, discipline tags) by naming it in
 * `repo:`.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import DataTable from '../components/ui/DataTable.astro';
import { getPublicRepos, updatedLabel } from '../lib/github';
import { JOIN_HREF, SITE } from '../data/site';

/** Repositories shown before "Show all". */
const REPO_PAGE = 8;

/** What ESRA projects can involve. */
const AREAS = [
  {
    title: 'Humanoids',
    body: 'Mechanical systems, balance, whole-body control, perception, computing, power, integration',
  },
  {
    title: 'Quadrupeds',
    body: 'Legged robotics, actuator control, gait development, state estimation, locomotion',
  },
  {
    title: 'Manipulators',
    body: 'Robot arms, end effectors, calibration, force-aware control, manipulation',
  },
  {
    title: 'Enabling systems',
    body: 'Custom electronics, embedded systems, software, simulation, test rigs, tooling',
  },
];

/** Inside H1: how the flagship is built across universities. */
const BUILT = [
  'Each university develops its assigned subsystems against a shared technical baseline.',
  'Parts travel between universities, and engineers visit other teams for hands-on work.',
  'Everything comes together at two-week, in-person integration sessions.',
  'Every session is recorded: telemetry, configurations, calibration changes, test conditions and video.',
];

/** The two weeks of an integration session, day by day. */
const SESSION = [
  [
    '1–2',
    'Assemble the robot, calibrate sensors and joints',
    'A calibrated system and baseline data',
  ],
  ['3–5', 'Tune control on the real hardware', 'Controller settings and measured response'],
  [
    '6–7',
    'Trace and fix failures across subsystems',
    'Failure analysis and before-and-after tests',
  ],
  [
    '8–10',
    'Run agreed experiments; compare with simulation',
    'Datasets and simulation comparisons',
  ],
  ['11–12', 'Repeat trials for reliability and heat', 'Repeatability and reliability data'],
  ['13–14', 'Confirm the best setups', 'Validated configurations and curated datasets'],
];

/** What every release on GitHub includes. */
const RELEASE = [
  'CAD files',
  'Bills of materials',
  'Electronics docs',
  'Source code',
  'Setup instructions',
  'Calibration procedures',
  'Test resources',
  'Versioned releases',
];

// TODO(confirm): "papers" or "reports"? The sources use both. Until it is
// settled, the line names both.
const REPORTS =
  'Technical papers and reports document design decisions, methods, results and limitations. The final H1 report is a full build guide.';

const [repos, curated, allPrograms, allFeatured] = await Promise.all([
  getPublicRepos(),
  getCollection('projects'),
  getCollection('programs'),
  getCollection('featured'),
]);

/* --- Recent activity: hand-picked posts and links -------------------
 * From src/content/featured.yaml. Shown above the repositories, and only
 * when there is something in it. The repositories themselves are listed
 * most recently updated first, so the latest code activity leads that
 * list already. */
const FEATURED_KIND = { linkedin: 'LinkedIn', repo: 'Repo', link: 'Link' };
const posts = allFeatured
  .filter((f) => !f.data.draft)
  .sort(
    (a, b) =>
      (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) || a.data.order - b.data.order
  )
  .slice(0, 5);
const postDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

/* --- 1. The roadmap ------------------------------------------------ */
const programs = [...allPrograms].sort((a, b) => a.data.order - b.data.order);
const flagship = programs.find((p) => p.data.flagship);
const otherPrograms = programs.filter((p) => p !== flagship);

const STATUS_LABEL = { active: 'In progress', planned: 'Planned', complete: 'Complete' };

const now = new Date();
const milestones = flagship?.data.milestones ?? [];
const currentMilestone = milestones.findLastIndex((m) => m.starts <= now);

/* --- 2. From the workshop ------------------------------------------ */
const builds = curated
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const BUILD_STATUS = {
  active: 'Active',
  prototype: 'Prototype',
  shipped: 'Shipped',
  archived: 'Archived',
};

/* --- 3. Repositories, enriched where a project file names one ------ */
const overrideByRepo = new Map(
  curated.filter((p) => p.data.repo).map((p) => [p.data.repo!.toLowerCase(), p])
);

const repositories = repos.map((repo) => {
  const override = overrideByRepo.get(repo.fullName.toLowerCase());
  return {
    key: repo.fullName,
    name: override?.data.title ?? repo.name,
    summary: override?.data.summary ?? repo.description,
    url: repo.url,
    language: repo.language,
    stars: repo.stars,
    updated: updatedLabel(repo.pushedAt),
    topics: (override?.data.domains.length ? override.data.domains : repo.topics).slice(0, 4),
  };
});

const hiddenCount = Math.max(0, repositories.length - REPO_PAGE);
---

<BaseLayout
  title="Projects"
  description="The robots ESRA is building, the hardware written up from the workshop, and every open-source repository."
>
  <PageHero
    eyebrow="Projects"
    title="Real robots, built in the open."
    lede="Humanoids, quadrupeds and manipulators, built by student teams across universities and documented well enough for others to rebuild."
  >
    <a class="btn" href="#roadmap">
      See the roadmap <Icon name="lucide:arrow-down" aria-hidden="true" />
    </a>
    <a class="btn secondary" href="#repositories">
      <Icon name="simple-icons:github" aria-hidden="true" />
      {repositories.length > 0 ? `${repositories.length} repositories` : 'Repositories'}
    </a>
  </PageHero>

  <!-- ============================================================
       1 — Project areas
       ============================================================ -->
  <Section id="areas" pad="tight">
    <SectionHead size="sm" eyebrow="Project areas" title="What ESRA projects can involve" />
    <ul class="areas">
      {
        AREAS.map((a) => (
          <li class="area card">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ============================================================
       2 — The roadmap
       ============================================================ -->
  <Section id="roadmap" pad="tight">
    <SectionHead
      eyebrow="2026–27 roadmap"
      title="On the roadmap"
      lede="The robots teams across the network are building this year. Each one is agreed between campuses, developed on them, and integrated together."
    />

    {
      flagship && (
        <article id={flagship.id} class="flag card">
          <div class="flag-main">
            <div class="flag-chips">
              <span class="chip">
                {flagship.data.status === 'active' && <span class="pulse" aria-hidden="true" />}
                {STATUS_LABEL[flagship.data.status]}
              </span>
              {flagship.data.level && <span class="chip">{flagship.data.level}</span>}
              <span class="chip outline">{flagship.data.kind}</span>
            </div>

            <h3>{flagship.data.title}</h3>
            <p class="flag-summary">{flagship.data.summary}</p>
            {flagship.data.description && <p class="flag-body">{flagship.data.description}</p>}

            {flagship.data.focus.length > 0 && (
              <ul class="flag-focus" aria-label="Subsystems">
                {flagship.data.focus.map((f) => (
                  <li class="chip outline">{f}</li>
                ))}
              </ul>
            )}

            <div class="flag-actions">
              <a class="btn" href="/#h1">
                Meet {flagship.data.designation ?? flagship.data.title}
                <Icon name="lucide:arrow-right" class="arrow" aria-hidden="true" />
              </a>
              <a class="btn secondary" href={JOIN_HREF}>
                Join the build
              </a>
            </div>
          </div>

          {milestones.length > 0 && (
            <div class="flag-side">
              <p class="flag-side-label">
                Schedule
                {flagship.data.timeframe && <span>{flagship.data.timeframe}</span>}
              </p>
              <ol class="mini">
                {milestones.map((m, i) => (
                  <li
                    class:list={{
                      done: i < currentMilestone,
                      current: i === currentMilestone,
                    }}
                  >
                    <span class="mini-node" aria-hidden="true" />
                    <span class="mini-when">
                      {m.when}
                      {i === currentMilestone && <span class="chip solid">Now</span>}
                      {i < currentMilestone && <span class="sr-only">(done)</span>}
                    </span>
                    <strong>{m.title}</strong>
                  </li>
                ))}
              </ol>
              <div class="flag-links">
                <a class="link-arrow down" href="#inside-h1">
                  How {flagship.data.designation ?? flagship.data.title} is built
                  <Icon name="lucide:arrow-down" aria-hidden="true" />
                </a>
                <a class="link-arrow" href="/events">
                  Events and calendar <Icon name="lucide:arrow-right" aria-hidden="true" />
                </a>
              </div>
            </div>
          )}
        </article>
      )
    }

    {
      otherPrograms.length > 0 && (
        <div class="program-grid">
          {otherPrograms.map((p) => (
            <article id={p.id} class="program card">
              <div class="program-top">
                <p class="program-kind">
                  {p.data.kind}
                  {p.data.level && <> · {p.data.level}</>}
                </p>
                <span class:list={['chip', { solid: p.data.status === 'active' }]}>
                  {p.data.status === 'active' && <span class="pulse" aria-hidden="true" />}
                  {STATUS_LABEL[p.data.status]}
                </span>
              </div>
              <h3>{p.data.title}</h3>
              <p class="program-body">{p.data.summary}</p>
              {p.data.timeframe && <p class="program-when">{p.data.timeframe}</p>}
            </article>
          ))}
        </div>
      )
    }

    <p class="roadmap-note">
      Want to work on one of these?{' '}
      <a class="link-arrow" href={JOIN_HREF}>
        See the ways in <Icon name="lucide:arrow-right" aria-hidden="true" />
      </a>
    </p>
  </Section>

  <!-- ============================================================
       3 — Inside H1
       ============================================================ -->
  <Section id="inside-h1" tone="white">
    <SectionHead eyebrow="Inside H1" title="How it’s built" />
    <ol class="built">
      {
        BUILT.map((b, i) => (
          <li class="built-step">
            <span class="built-no" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p>{b}</p>
          </li>
        ))
      }
    </ol>

    <div class="session">
      <SectionHead
        as="h3"
        size="sm"
        eyebrow="Two weeks in person"
        title="Inside an integration session"
      />
      <div>
        <DataTable
          columns={['Days', 'What happens', 'What it produces']}
          rows={SESSION}
          label="Inside an integration session"
          minWidth="20rem"
        />
      </div>
    </div>
  </Section>

  <!-- ============================================================
       4 — From the workshop
       ============================================================ -->
  {
    builds.length > 0 && (
      <Section id="builds" tone="band">
        <SectionHead
          eyebrow="From the workshop"
          title="Builds, written up"
          lede="Hardware documented well enough to rebuild: what it is, how it was made, and the parts list."
        />

        <div class="build-grid">
          {builds.map((b) => (
            <article class="build card lift">
              <div class="build-top">
                <span class="chip">{BUILD_STATUS[b.data.status]}</span>
                {b.data.revision && <span class="chip outline">{b.data.revision}</span>}
              </div>
              <h3>
                <a class="stretch" href={`/projects/${b.id}`}>
                  {b.data.title}
                </a>
              </h3>
              <p class="build-body">{b.data.summary}</p>
              <div class="build-foot">
                {b.data.domains.length > 0 && (
                  <ul class="topics" aria-label="Disciplines">
                    {b.data.domains.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                )}
                <span class="link-arrow" aria-hidden="true">
                  Read the write-up <Icon name="lucide:arrow-right" />
                </span>
              </div>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <!-- ============================================================
       5 — Open documentation
       ============================================================ -->
  <Section id="open-documentation" pad="flush-bottom">
    <SectionHead
      eyebrow="Open source"
      title="Engineering others can rebuild."
      lede="Every project is published on GitHub, so other student teams can understand the design decisions, reproduce the work and build on it."
    />

    <div class="docs-grid">
      <section class="docs-card card" aria-labelledby="release-title">
        <h3 id="release-title">Each release includes</h3>
        <ul class="release">
          {RELEASE.map((r) => <li>{r}</li>)}
        </ul>
      </section>
      <section class="docs-card card" aria-labelledby="reports-title">
        <h3 id="reports-title">Reports</h3>
        <p>{REPORTS}</p>
      </section>
    </div>

    <aside class="ira" aria-labelledby="ira-title">
      <p class="ira-label">Coming soon</p>
      <h3 id="ira-title">Industry Research Alliance</h3>
      <p>
        A company brings a research question. Research labs carry out the work, with qualified ESRA
        students involved from the start. Separate from H1 and its public releases.
      </p>
    </aside>
  </Section>

  <!-- ============================================================
       6 — Recent activity (only when featured.yaml has entries)
       ============================================================ -->
  {
    posts.length > 0 && (
      <Section id="activity" pad="flush-bottom">
        <SectionHead size="sm" eyebrow="Elsewhere" title="Recent activity" />
        <ul class="activity">
          {posts.map((f) => (
            <li>
              <a href={f.data.url} rel="noopener" target="_blank">
                <span class="act-kind">{FEATURED_KIND[f.data.type]}</span>
                <span class="act-title">{f.data.title}</span>
                {f.data.date && (
                  <time class="act-date" datetime={f.data.date.toISOString()}>
                    {postDate.format(f.data.date)}
                  </time>
                )}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- ============================================================
       7 — Repositories
       ============================================================ -->
  <Section id="repositories" pad="flush-bottom">
    <SectionHead
      eyebrow="On GitHub"
      title="Repositories"
      lede="Everything here is public, most recently updated first. The figures come straight from GitHub each time the site is built — none of it is maintained by hand."
    >
      <a slot="aside" class="link-arrow out" href={SITE.orgUrl} rel="noopener" target="_blank">
        All repositories on GitHub <Icon name="lucide:arrow-up-right" aria-hidden="true" />
      </a>
    </SectionHead>

    {
      repositories.length === 0 ? (
        <p class="empty card">
          Repository data is unavailable right now. It will reappear on the next build — in the
          meantime, everything is on{' '}
          <a href={SITE.orgUrl} rel="noopener">
            GitHub
          </a>
          .
        </p>
      ) : (
        <>
          <ul id="repo-list" class="repo-grid" data-repo-list>
            {repositories.map((r, i) => (
              <li class:list={['repo', 'card', 'lift', { extra: i >= REPO_PAGE }]}>
                <h3>
                  <a class="stretch" href={r.url} rel="noopener" target="_blank">
                    {r.name}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </h3>

                <p class="repo-desc">{r.summary ?? 'No description yet.'}</p>

                {r.topics.length > 0 && (
                  <ul class="topics" aria-label="Topics">
                    {r.topics.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}

                <p class="repo-meta">
                  {r.language && <span>{r.language}</span>}
                  {r.stars > 0 && (
                    <span>
                      <span aria-hidden="true">★</span> {r.stars}
                      <span class="sr-only"> stars</span>
                    </span>
                  )}
                  {r.updated && <span>{r.updated}</span>}
                </p>
              </li>
            ))}
          </ul>

          {hiddenCount > 0 && (
            <div class="repo-more">
              <p class="repo-count" data-repo-count aria-live="polite">
                Showing {REPO_PAGE} of {repositories.length}
              </p>
              <button
                type="button"
                class="btn secondary"
                aria-expanded="false"
                aria-controls="repo-list"
                data-repo-toggle
                data-total={repositories.length}
                data-page={REPO_PAGE}
              >
                <span data-repo-label>Show all {repositories.length} repositories</span>
                <Icon name="lucide:chevron-down" class="chev" aria-hidden="true" />
              </button>
            </div>
          )}
        </>
      )
    }
  </Section>
</BaseLayout>

<script>
  // "Show all": the repositories past the first eight are in the page
  // from the start and only hidden (and only once this script is known to
  // run — see the .js rule in the styles), so nothing is fetched and the
  // list is complete without JS.
  const list = document.querySelector<HTMLElement>('[data-repo-list]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-repo-toggle]');
  const label = document.querySelector<HTMLElement>('[data-repo-label]');
  const count = document.querySelector<HTMLElement>('[data-repo-count]');

  if (list && toggle && label) {
    const total = Number(toggle.dataset.total);
    const page = Number(toggle.dataset.page);

    const setExpanded = (expanded: boolean) => {
      list.toggleAttribute('data-expanded', expanded);
      toggle.setAttribute('aria-expanded', String(expanded));
      label.textContent = expanded ? 'Show fewer' : `Show all ${total} repositories`;
      if (count) count.textContent = `Showing ${expanded ? total : page} of ${total}`;
    };

    toggle.addEventListener('click', () => {
      const expanding = !list.hasAttribute('data-expanded');
      setExpanded(expanding);
      // Folding the list back shortens the page above the button; keep
      // the button where the reader's eye already is.
      if (!expanding) toggle.scrollIntoView({ block: 'center' });
    });
  }
</script>

<style>
  /* ================================================================
   * Project areas
   * ============================================================== */
  .areas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .area {
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  .area h3 {
    font-size: var(--t-xl);
  }

  .area p {
    margin: var(--space-2) 0 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-body);
  }

  /* ================================================================
   * Roadmap: the flagship
   * ============================================================== */
  .flag {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    overflow: hidden;
  }

  .flag-main {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .flag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .flag h3 {
    margin-top: var(--space-4);
    font-size: var(--t-h2);
  }

  .flag-summary {
    margin: var(--space-3) 0 0;
    font-size: var(--t-lg);
    font-weight: var(--w-medium);
    color: var(--ink-strong);
  }

  .flag-body {
    max-width: var(--measure);
    margin: var(--space-3) 0 0;
    color: var(--ink-body);
  }

  .flag-focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .flag-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .flag-side {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-left: 1px solid var(--band-edge);
    background: var(--band);
  }

  .flag-side-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .flag-side-label span {
    letter-spacing: 0.02em;
    text-transform: none;
  }

  /* The schedule, as a short ladder. */
  .mini {
    flex: 1;
    margin: var(--space-5) 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .mini li {
    position: relative;
    display: grid;
    gap: 0.125rem;
    padding: 0 0 var(--space-5) 1.75rem;
  }

  .mini li:last-child {
    padding-bottom: 0;
  }

  /* The rail between one rung and the next. */
  .mini li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.3125rem;
    top: 0.875rem;
    bottom: -0.375rem;
    width: 2px;
    background: var(--band-edge);
  }

  .mini li.done:not(:last-child)::before {
    background: var(--blue);
  }

  .mini-node {
    position: absolute;
    left: 0;
    top: 0.3125rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--rule-strong);
    border-radius: 50%;
    background: var(--band);
  }

  .mini li.done .mini-node {
    border-color: var(--blue);
    background: var(--blue);
  }

  .mini li.current .mini-node {
    border-color: var(--blue);
    background: var(--surface);
  }

  .mini-when {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-muted);
  }

  .mini li.current .mini-when {
    color: var(--blue-strong);
  }

  .mini strong {
    font-weight: var(--w-semibold);
    line-height: 1.4;
    color: var(--ink-strong);
  }

  .flag-links {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }

  /* ================================================================
   * Roadmap: the other programmes
   * ============================================================== */
  .program-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .program {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
  }

  /* Arriving from a search result or a link: say which card was meant. */
  .program:target,
  .flag:target {
    border-color: var(--blue);
    box-shadow: 0 0 0 1px var(--blue);
  }

  .program-top {
    display: flex;
