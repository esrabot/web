---
/**
 * Projects.
 *
 * Three shelves, from the largest thing down:
 *
 *   1. The roadmap — the robots ESRA is building or has committed to
 *      build (src/content/programs.yaml).
 *   2. From the workshop — builds written up in full, each with a page of
 *      its own (src/content/projects/*.md).
 *   3. Repositories — generated from the org's real repositories, so the
 *      list stays current with no hand-maintenance. It shows the first
 *      eight; a button brings in the rest.
 *
 * A markdown file in src/content/projects can also enrich a repository's
 * card (a better title or summary, discipline tags) by naming it in
 * `repo:`.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import { getPublicRepos, updatedLabel } from '../lib/github';
import { JOIN_HREF, SITE } from '../data/site';

/** Repositories shown before "Show all". */
const REPO_PAGE = 8;

const [repos, curated, allPrograms] = await Promise.all([
  getPublicRepos(),
  getCollection('projects'),
  getCollection('programs'),
]);

/* --- 1. The roadmap ------------------------------------------------ */
const programs = [...allPrograms].sort((a, b) => a.data.order - b.data.order);
const flagship = programs.find((p) => p.data.flagship);
const otherPrograms = programs.filter((p) => p !== flagship);

const STATUS_LABEL = { active: 'In progress', planned: 'Planned', complete: 'Complete' };

const now = new Date();
const milestones = flagship?.data.milestones ?? [];
const currentMilestone = milestones.findLastIndex((m) => m.starts <= now);

/* --- 2. From the workshop ------------------------------------------ */
const builds = curated
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const BUILD_STATUS = {
  active: 'Active',
  prototype: 'Prototype',
  shipped: 'Shipped',
  archived: 'Archived',
};

/* --- 3. Repositories, enriched where a project file names one ------ */
const overrideByRepo = new Map(
  curated.filter((p) => p.data.repo).map((p) => [p.data.repo!.toLowerCase(), p])
);

const repositories = repos.map((repo) => {
  const override = overrideByRepo.get(repo.fullName.toLowerCase());
  return {
    key: repo.fullName,
    name: override?.data.title ?? repo.name,
    summary: override?.data.summary ?? repo.description,
    url: repo.url,
    language: repo.language,
    stars: repo.stars,
    updated: updatedLabel(repo.pushedAt),
    topics: (override?.data.domains.length ? override.data.domains : repo.topics).slice(0, 4),
  };
});

const hiddenCount = Math.max(0, repositories.length - REPO_PAGE);
---

<BaseLayout
  title="Projects"
  description="The robots ESRA is building, the hardware written up from the workshop, and every open-source repository."
>
  <PageHero
    eyebrow="Projects"
    title="What we are building."
    lede="A full-scale humanoid first, with a quadruped and two manipulators alongside it — and everything we make along the way, published in the open."
  >
    <Fragment slot="title">What we are <em>building.</em></Fragment>
    <a class="btn" href="#roadmap">
      See the roadmap <Icon name="lucide:arrow-down" aria-hidden="true" />
    </a>
    <a class="btn secondary" href="#repositories">
      <Icon name="simple-icons:github" aria-hidden="true" />
      {repositories.length > 0 ? `${repositories.length} repositories` : 'Repositories'}
    </a>
  </PageHero>

  <!-- ============================================================
       1 — The roadmap
       ============================================================ -->
  <Section id="roadmap" pad="tight">
    <SectionHead
      eyebrow="2026–27 roadmap"
      title="On the roadmap"
      lede="The robots teams across the network are building this year. Each one is agreed between campuses, developed on them, and integrated together."
    />

    {
      flagship && (
        <article id={flagship.id} class="flag card" data-reveal>
          <div class="flag-main">
            <div class="flag-chips">
              <span class="chip solid">
                {flagship.data.status === 'active' && <span class="pulse" aria-hidden="true" />}
                {STATUS_LABEL[flagship.data.status]}
              </span>
              {flagship.data.level && <span class="chip sand">{flagship.data.level}</span>}
              <span class="chip outline">{flagship.data.kind}</span>
            </div>

            {flagship.data.designation && (
              <p class="flag-designation" aria-hidden="true">
                {flagship.data.designation}
              </p>
            )}
            <h3>{flagship.data.title}</h3>
            <p class="flag-summary">{flagship.data.summary}</p>
            {flagship.data.description && <p class="flag-body">{flagship.data.description}</p>}

            {flagship.data.focus.length > 0 && (
              <ul class="flag-focus" aria-label="Subsystems">
                {flagship.data.focus.map((f) => (
                  <li class="chip outline">{f}</li>
                ))}
              </ul>
            )}

            <div class="flag-actions">
              <a class="btn" href="/#h1">
                Meet {flagship.data.designation ?? flagship.data.title}
                <Icon name="lucide:arrow-right" class="arrow" aria-hidden="true" />
              </a>
              <a class="btn secondary" href={JOIN_HREF}>
                Join the build
              </a>
            </div>
          </div>

          {milestones.length > 0 && (
            <div class="flag-side">
              <p class="flag-side-label">
                Schedule
                {flagship.data.timeframe && <span>{flagship.data.timeframe}</span>}
              </p>
              <ol class="mini">
                {milestones.map((m, i) => (
                  <li
                    class:list={{
                      done: i < currentMilestone,
                      current: i === currentMilestone,
                    }}
                  >
                    <span class="mini-node" aria-hidden="true" />
                    <span class="mini-when">
                      {m.when}
                      {i === currentMilestone && <span class="chip solid">Now</span>}
                      {i < currentMilestone && <span class="sr-only">(done)</span>}
                    </span>
                    <strong>{m.title}</strong>
                  </li>
                ))}
              </ol>
              <a class="link-arrow" href="/events">
                Events and calendar <Icon name="lucide:arrow-right" aria-hidden="true" />
              </a>
            </div>
          )}
        </article>
      )
    }

    {
      otherPrograms.length > 0 && (
        <div class="program-grid">
          {otherPrograms.map((p, i) => (
            <article id={p.id} class="program card" data-reveal style={`--i: ${i}`}>
              <div class="program-top">
                <p class="program-kind">
                  {p.data.kind}
                  {p.data.level && <> · {p.data.level}</>}
                </p>
                <span class:list={['chip', p.data.status === 'active' ? 'solid' : 'sand']}>
                  {p.data.status === 'active' && <span class="pulse" aria-hidden="true" />}
                  {STATUS_LABEL[p.data.status]}
                </span>
              </div>
              <h3>{p.data.title}</h3>
              <p class="program-body">{p.data.summary}</p>
              {p.data.timeframe && <p class="program-when">{p.data.timeframe}</p>}
            </article>
          ))}
        </div>
      )
    }

    <p class="roadmap-note" data-reveal>
      Want to work on one of these?{' '}
      <a class="link-arrow" href={JOIN_HREF}>
        See the ways in <Icon name="lucide:arrow-right" aria-hidden="true" />
      </a>
    </p>
  </Section>

  <!-- ============================================================
       2 — From the workshop
       ============================================================ -->
  {
    builds.length > 0 && (
      <Section id="builds" tone="sand">
        <SectionHead
          eyebrow="From the workshop"
          title="Builds, written up"
          lede="Hardware documented well enough to rebuild: what it is, how it was made, and the parts list."
        />

        <div class="build-grid">
          {builds.map((b, i) => (
            <article class="build card lift" data-reveal style={`--i: ${i}`}>
              <div class="build-top">
                <span class="chip">{BUILD_STATUS[b.data.status]}</span>
                {b.data.revision && <span class="chip outline">{b.data.revision}</span>}
              </div>
              <h3>
                <a class="stretch" href={`/projects/${b.id}`}>
                  {b.data.title}
                </a>
              </h3>
              <p class="build-body">{b.data.summary}</p>
              <div class="build-foot">
                {b.data.domains.length > 0 && (
                  <ul class="topics" aria-label="Disciplines">
                    {b.data.domains.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                )}
                <span class="link-arrow" aria-hidden="true">
                  Read the write-up <Icon name="lucide:arrow-right" />
                </span>
              </div>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <!-- ============================================================
       3 — Repositories
       ============================================================ -->
  <Section id="repositories" pad="flush-bottom">
    <SectionHead
      eyebrow="Open source"
      title="Repositories"
      lede="Everything here is public. The figures come straight from GitHub each time the site is built — none of it is maintained by hand."
    >
      <a slot="aside" class="link-arrow out" href={SITE.orgUrl} rel="noopener" target="_blank">
        All repositories on GitHub <Icon name="lucide:arrow-up-right" aria-hidden="true" />
      </a>
    </SectionHead>

    {
      repositories.length === 0 ? (
        <p class="empty card">
          Repository data is unavailable right now. It will reappear on the next build — in the
          meantime, everything is on{' '}
          <a href={SITE.orgUrl} rel="noopener">
            GitHub
          </a>
          .
        </p>
      ) : (
        <>
          <ul id="repo-list" class="repo-grid" data-repo-list>
            {repositories.map((r, i) => (
              <li
                class:list={['repo', 'card', 'lift', { extra: i >= REPO_PAGE }]}
                data-reveal
                style={`--i: ${i % 4}`}
              >
                <div class="repo-top">
                  <Icon name="simple-icons:github" class="repo-gh" aria-hidden="true" />
                  <h3>
                    <a class="stretch" href={r.url} rel="noopener" target="_blank">
                      {r.name}
                      <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  </h3>
                  <Icon name="lucide:arrow-up-right" class="repo-go" aria-hidden="true" />
                </div>

                <p class="repo-desc">{r.summary ?? 'No description yet.'}</p>

                {r.topics.length > 0 && (
                  <ul class="topics" aria-label="Topics">
                    {r.topics.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}

                <p class="repo-meta">
                  {r.language && (
                    <span class="repo-lang">
                      <span class="lang-dot" aria-hidden="true" />
                      {r.language}
                    </span>
                  )}
                  {r.stars > 0 && (
                    <span>
                      <span aria-hidden="true">★</span> {r.stars}
                      <span class="sr-only"> stars</span>
                    </span>
                  )}
                  {r.updated && <span>{r.updated}</span>}
                </p>
              </li>
            ))}
          </ul>

          {hiddenCount > 0 && (
            <div class="repo-more">
              <p class="repo-count" data-repo-count aria-live="polite">
                Showing {REPO_PAGE} of {repositories.length}
              </p>
              <button
                type="button"
                class="btn secondary"
                aria-expanded="false"
                aria-controls="repo-list"
                data-repo-toggle
                data-total={repositories.length}
                data-page={REPO_PAGE}
              >
                <span data-repo-label>Show all {repositories.length} repositories</span>
                <Icon name="lucide:chevron-down" class="chev" aria-hidden="true" />
              </button>
            </div>
          )}
        </>
      )
    }
  </Section>
</BaseLayout>

<script>
  // "Show all": the repositories past the first eight are in the page
  // from the start and only hidden (and only once this script is known to
  // run — see the .js rule in the styles), so nothing is fetched and the
  // list is complete without JS.
  const list = document.querySelector<HTMLElement>('[data-repo-list]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-repo-toggle]');
  const label = document.querySelector<HTMLElement>('[data-repo-label]');
  const count = document.querySelector<HTMLElement>('[data-repo-count]');

  if (list && toggle && label) {
    const total = Number(toggle.dataset.total);
    const page = Number(toggle.dataset.page);

    const setExpanded = (expanded: boolean) => {
      list.toggleAttribute('data-expanded', expanded);
      toggle.setAttribute('aria-expanded', String(expanded));
      label.textContent = expanded ? 'Show fewer' : `Show all ${total} repositories`;
      if (count) count.textContent = `Showing ${expanded ? total : page} of ${total}`;
    };

    toggle.addEventListener('click', () => {
      const expanding = !list.hasAttribute('data-expanded');
      setExpanded(expanding);
      // Folding the list back shortens the page above the button; keep
      // the button where the reader's eye already is.
      if (!expanding) toggle.scrollIntoView({ block: 'center' });
    });
  }
</script>

<style>
  /* ================================================================
   * Roadmap: the flagship
   * ============================================================== */
  .flag {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    overflow: hidden;
    scroll-margin-top: calc(var(--header-h) + var(--space-5));
  }

  .flag-main {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .flag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .flag-designation {
    margin: var(--space-5) 0 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 3rem + 6vw, 7.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--blue);
  }

  .flag h3 {
    margin-top: var(--space-4);
    font-size: var(--t-h2);
  }

  .flag-summary {
    margin: var(--space-3) 0 0;
    font-size: var(--t-lg);
    font-weight: var(--w-medium);
    color: var(--ink-strong);
  }

  .flag-body {
    max-width: var(--measure);
    margin: var(--space-3) 0 0;
    color: var(--ink-body);
  }

  .flag-focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .flag-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .flag-side {
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-left: 1px solid var(--sand-deep);
    background: var(--sand);
  }

  .flag-side-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--sand-ink);
  }

  .flag-side-label span {
    letter-spacing: 0.02em;
    text-transform: none;
  }

  /* The schedule, as a short ladder. */
  .mini {
    flex: 1;
    margin: var(--space-5) 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .mini li {
    position: relative;
    display: grid;
    gap: 0.125rem;
    padding: 0 0 var(--space-5) 1.75rem;
  }

  .mini li:last-child {
    padding-bottom: 0;
  }

  /* The rail between one rung and the next. */
  .mini li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 0.3125rem;
    top: 0.875rem;
    bottom: -0.375rem;
    width: 2px;
    background: var(--sand-deep);
  }

  .mini li.done:not(:last-child)::before {
    background: var(--blue);
  }

  .mini-node {
    position: absolute;
    left: 0;
    top: 0.3125rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--sand-deep);
    border-radius: 50%;
    background: var(--sand);
  }

  .mini li.done .mini-node {
    border-color: var(--blue);
    background: var(--blue);
  }

  .mini li.current .mini-node {
    border-color: var(--blue);
    background: var(--surface);
    box-shadow: 0 0 0 4px rgba(36, 80, 200, 0.16);
  }

  .mini-when {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--sand-ink);
  }

  .mini li.current .mini-when {
    color: var(--blue-strong);
  }

  .mini strong {
    font-weight: var(--w-semibold);
    line-height: 1.4;
    color: var(--ink-strong);
  }

  /* ================================================================
   * Roadmap: the other programmes
   * ============================================================== */
  .program-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .program {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    scroll-margin-top: calc(var(--header-h) + var(--space-5));
    transition:
      border-color var(--dur-slow) var(--ease),
      box-shadow var(--dur-slow) var(--ease-out);
  }

  /* Arriving from a search result or a link: say which card was meant. */
  .program:target,
  .flag:target {
    border-color: var(--blue);
    box-shadow:
      0 0 0 4px var(--blue-soft),
      var(--shadow-md);
  }

  .program-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .program-kind {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue);
  }

  .program h3 {
    margin-top: var(--space-5);
    font-size: var(--t-h3);
  }

  .program-body {
    flex: 1;
    margin: var(--space-2) 0 0;
    color: var(--ink-body);
  }

  .program-when {
    margin: var(--space-4) 0 0;
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-muted);
  }

  .roadmap-note {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-7) 0 0;
    color: var(--ink-muted);
  }

  /* ================================================================
   * From the workshop
   * ============================================================== */
  .build-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
  }

  /* One write-up should not stretch across the whole band. */
  .build-grid > :only-child {
    max-width: 44rem;
  }

  .build {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
  }

  .build-top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .build h3 {
    margin-top: var(--space-4);
    font-size: var(--t-h3);
  }

  .build h3 a {
    color: inherit;
    text-decoration: none;
  }

  .build:hover h3 a {
    color: var(--blue);
  }

  .build-body {
    flex: 1;
    max-width: var(--measure);
    margin: var(--space-3) 0 0;
    color: var(--ink-body);
  }

  .build-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule-soft);
  }

  .build-foot .link-arrow {
    font-size: var(--t-sm);
  }

  .build:hover .link-arrow :global(svg) {
    transform: translateX(3px);
  }

  /* Small plain-text tags: disciplines on a build, topics on a repo. */
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topics li {
    padding: 0.125rem 0.5rem;
    border-radius: var(--r-pill);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--rule);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* ================================================================
   * Repositories
   * ============================================================== */
  .repo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .repo {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
  }

  /* Past the first eight: put away until "Show all" — but only where the
     script that brings them back is running. */
  :global(.js) .repo-grid:not([data-expanded]) .repo.extra {
    display: none;
  }

  .repo-top {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .repo-gh {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--ink-strong);
  }

  .repo h3 {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--t-base);
    font-weight: var(--w-medium);
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .repo h3 a {
    color: inherit;
    text-decoration: none;
  }

  .repo:hover h3 a {
    color: var(--blue);
  }

  .repo-go {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--ink-faint);
    transition:
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease-out);
  }

  .repo:hover .repo-go {
    color: var(--blue);
    transform: translate(2px, -2px);
  }

  .repo-desc {
    flex: 1;
    margin: var(--space-3) 0 var(--space-4);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-body);
  }

  .repo-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-soft);
    font-size: var(--t-xs);
    color: var(--ink-muted);
  }

  .repo-lang {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .lang-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--blue);
  }

  .repo-more {
    display: none;
