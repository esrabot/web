---
/**
 * Home.
 *
 * Reads top to bottom as an argument: what ESRA is, why it exists, the
 * robot it is building and when, how to join in, what has happened
 * lately, and who is already here.
 *
 * Every figure is real: counts come from the partners and programmes
 * lists, repo stats from the GitHub API at build time. The schedule's
 * "now" marker is computed from the build date, and the scheduled
 * rebuild keeps it current.
 *
 * The four "ways in" open as pop-up cards. Their copy lives in
 * src/content/pathways.yaml, the roadmap in src/content/programs.yaml.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import PartnerMark from '../components/ui/PartnerMark.astro';
import DataTable from '../components/ui/DataTable.astro';
import { CONTACTS, SITE } from '../data/site';
import { getPublicRepos } from '../lib/github';

const [repos, partners, allFeatured, allPrograms, allPathways] = await Promise.all([
  getPublicRepos(),
  getCollection('partners'),
  getCollection('featured'),
  getCollection('programs'),
  getCollection('pathways'),
]);

const schoolCount = new Set(partners.map((p) => p.data.school)).size;

/* ------------------------------------------------------------------
 * The roadmap, and the flagship's schedule.
 * ---------------------------------------------------------------- */
const programs = [...allPrograms].sort((a, b) => a.data.order - b.data.order);
const flagship = programs.find((p) => p.data.flagship);
const otherPrograms = programs.filter((p) => p !== flagship);

const milestones = flagship?.data.milestones ?? [];
const now = new Date();
const current = milestones.findLastIndex((m) => m.starts <= now);

// How much of each milestone's run to the next one has elapsed, 0..1:
// finished stretches are full, the current one is part-way, the rest empty.
const fills = milestones.map((m, i) => {
  if (i < current) return 1;
  if (i > current) return 0;
  const next = milestones[i + 1];
  if (!next) return 0;
  const span = next.starts.getTime() - m.starts.getTime();
  return Math.min(1, Math.max(0, (now.getTime() - m.starts.getTime()) / span));
});

const firstWhen = milestones[0]?.when;
const lastWhen = milestones.at(-1)?.when;
const programStatus =
  current < 0
    ? `Starts ${firstWhen ?? 'soon'}`
    : current >= milestones.length - 1
      ? 'Completing'
      : 'In progress';

// "Launched: October 2026", from the day the first milestone began.
const monthYear = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const launched = milestones[0] ? monthYear.format(milestones[0].starts) : undefined;

// The outputs read as one sentence: "Technical papers and reports,
// engineering videos, …".
const outputsLine = (flagship?.data.outputs ?? [])
  .map((o, i) => (i === 0 ? o : o.charAt(0).toLowerCase() + o.slice(1)))
  .join(', ');

/** Why sharing one robot works: the four reasons under "Why ESRA". */
const reasons = [
  {
    title: 'Combine skills',
    body: 'Students contribute across mechanical, electrical, software and controls work.',
  },
  {
    title: 'Learn on real systems',
    body: 'Teams work through design decisions, physical testing, integration and iteration.',
  },
  {
    title: 'Stop repeating work',
    body: 'Shared code, drawings, test methods and documentation let teams build on each other.',
  },
  {
    title: 'Support goes further',
    body: 'One mentor or one piece of shared equipment helps many teams at once.',
  },
];

/** Who does what: the three roles that support the university teams. */
const supportRoles = [
  {
    title: 'Research labs and engineers',
    body: 'Mentor teams, review designs and advise on hard problems.',
  },
  {
    title: 'Companies',
    body: 'Supply funding, hardware, software, machining and technical support.',
  },
  {
    title: 'ESRA',
    body: 'Coordinates the teams, connects support, and keeps knowledge across student cohorts.',
  },
];
const teamsRole = {
  title: 'University teams',
  body: 'Design, build, program, test and document the robots.',
};

const steps = [
  {
    title: 'Define the project',
    body: 'Teams agree on the goal, the scope and the resources it needs.',
    output: 'Project scope',
  },
  {
    title: 'Split the work',
    body: 'Each team takes a subsystem, and the interfaces between them are agreed up front.',
    output: 'Owners + interfaces',
  },
  {
    title: 'Build at home',
    body: 'Each team develops and tests its part at its own university, with mentors’ feedback.',
    output: 'Tested subsystems',
  },
  {
    title: 'Integrate together',
    body: 'Teams meet in person to assemble the robot, test it, and trace faults across mechanical, electrical and software boundaries.',
    output: 'One working robot',
  },
  {
    title: 'Document it',
    body: 'Designs, code, test results and lessons are published so others can build on them.',
    output: 'Open releases',
  },
];

/* ------------------------------------------------------------------
 * Ways in.
 * ---------------------------------------------------------------- */
const general = CONTACTS[0].address;
const mailto = (address: string, subject: string) =>
  `mailto:${address}?subject=${encodeURIComponent(subject)}`;

const WAY_ICON = {
  student: 'lucide:graduation-cap',
  club: 'lucide:users',
  lab: 'lucide:flask-conical',
  company: 'lucide:building-2',
} as const;

const ways = [...allPathways]
  .sort((a, b) => a.data.order - b.data.order)
  .map((w) => ({
    ...w.data,
    id: w.id,
    dialogId: `way-${w.id}`,
    iconName: WAY_ICON[w.data.icon],
    href: mailto(w.data.email ?? general, w.data.subject),
    secondaryHref: w.data.secondary && mailto(w.data.secondary.email, w.data.secondary.subject),
    // A four-column table needs more room than the standard pop-up gives.
    wide: w.data.sections.some((s) => (s.table?.columns.length ?? 0) >= 4),
  }));

/* ------------------------------------------------------------------
 * Recent activity: featured links and repo pushes as a short list.
 * ---------------------------------------------------------------- */
interface Activity {
  date: Date | null;
  kind: string;
  title: string;
  source: string;
  href: string;
}

const FEATURED_KIND = { linkedin: 'LinkedIn', repo: 'Repo', link: 'Link' };

const activity: Activity[] = [
  ...allFeatured
    .filter((f) => !f.data.draft)
    .map((f) => ({
      date: f.data.date ?? null,
      kind: FEATURED_KIND[f.data.type],
      title: f.data.title,
      source: 'ESRA',
      href: f.data.url,
    })),
  ...repos.slice(0, 3).map((r) => ({
    date: r.pushedAt ? new Date(r.pushedAt) : null,
    kind: 'Repo',
    title: r.name,
    // A star count only once there is one: "★0" reads as a verdict.
    source: [r.language, r.stars > 0 && `★ ${r.stars}`].filter(Boolean).join(' · ') || 'GitHub',
    href: r.url,
  })),
]
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0))
  .slice(0, 5);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const fmt = (d: Date) => dateFmt.format(d);

const KIND_LABEL = {
  club: 'Club',
  school: 'School',
  company: 'Company',
  organization: 'Organization',
};

const STATUS_LABEL = { active: 'In progress', planned: 'Planned', complete: 'Complete' };
---

<BaseLayout>
  <!-- ============================================================
       Hero
       ============================================================ -->
  <section class="hero">
    <div class="hero-wash" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{SITE.fullName}</p>

        <h1>One robot.<br />Many campuses.</h1>

        <p class="lede">
          ESRA is a national nonprofit that connects university robotics teams, so they can share
          what they learn, split the engineering, and build robots no single campus could build
          alone.
        </p>

        <div class="hero-actions">
          <a class="btn lg" href="#join">
            Get involved <Icon name="lucide:arrow-right" class="arrow" aria-hidden="true" />
          </a>
          {
            flagship && (
              <a class="btn lg secondary" href="#h1">
                Meet {flagship.data.designation ?? flagship.data.title}
              </a>
            )
          }
        </div>

        <dl class="hero-facts">
          <div>
            <dt>Partners</dt>
            <dd>{partners.length}</dd>
          </div>
          <div>
            <dt>Schools</dt>
            <dd>{schoolCount}</dd>
          </div>
          <div>
            <dt>Robots on the roadmap</dt>
            <dd>{programs.length}</dd>
          </div>
          <div>
            <dt>Since</dt>
            <dd class="text">{SITE.established}</dd>
          </div>
          <div>
            <dt>Nonprofit status</dt>
            <dd class="text">{SITE.taxStatus}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="container">
      <div class="trust">
        <p class="trust-label">Built with teams at</p>
        <ul class="trust-list">
          {
            partners.map((p) => (
              <li>
                <a href={p.data.url} rel="noopener" target="_blank">
                  <PartnerMark partner={p} height={34} maxWidth={84} decorative />
                  <span class="trust-name">{p.data.name}</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="link-arrow trust-all" href="#partners">
          All {partners.length} partners <Icon name="lucide:arrow-down" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Why ESRA
       ============================================================ -->
  <Section id="why">
    <div class="why">
      <div class="why-copy">
        <SectionHead
          eyebrow="Why ESRA"
          title="Every campus debugging the same robot alone."
          align="center"
        />

        <div class="why-body">
          <p>
            Today, one team spends a semester working out joint control while another works through
            the same problem, with little chance to compare notes.
          </p>
          <p>
            In ESRA, teams share designs, code, test methods and lessons learned. Each team starts
            from what the others have already worked out, instead of repeating it or its mistakes.
            ESRA connects student robotics clubs with each other, and with research labs, engineers
            and companies.
          </p>
        </div>

        <aside class="example">
          <p class="example-label">For example</p>
          <p>
            On H1, the leg team needs its actuators’ dimensions and torque. The controller team
            needs to know how those joints move and what the sensors report. A joint build makes
            those handoffs explicit.
          </p>
        </aside>
      </div>
    </div>

    <div class="model">
      <SectionHead
        as="h3"
        size="sm"
        align="center"
        eyebrow="The model"
        title="Why the model works"
      />
      <ul class="reasons">
        {
          reasons.map((r, i) => (
            <li class="reason">
              <h4>{r.title}</h4>
              <p>{r.body}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="roles">
      <SectionHead as="h3" size="sm" align="center" eyebrow="The network" title="Who does what" />
      <figure class="roles-figure">
        <ul class="supports" aria-label="Supporting the teams">
          {
            supportRoles.map((r) => (
              <li class="role card">
                <h4>{r.title}</h4>
                <p>{r.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="role-bus" aria-hidden="true"></div>
        <div class="role card teams">
          <h4>{teamsRole.title}</h4>
          <p>{teamsRole.body}</p>
        </div>
        <figcaption>
          Teams stay responsible for their own work, and facilities stay with their universities.
        </figcaption>
      </figure>
    </div>

    <div class="process">
      <SectionHead
        as="h3"
        size="sm"
        align="center"
        eyebrow="The method"
        title="How a joint build works"
      />
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step card">
              <span class="step-no" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h4>{s.title}</h4>
              <p>{s.body}</p>
              <span class="chip">
                <Icon name="lucide:arrow-right" aria-hidden="true" />
                {s.output}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- ============================================================
       The flagship, its specification and its schedule
       ============================================================ -->
  {
    flagship && (
      <Section id="h1" tone="band">
        <div class="flagship">
          <div class="flagship-copy">
            <SectionHead eyebrow="Flagship programme" title={flagship.data.summary}>
              <Fragment slot="title">
                {flagship.data.designation && (
                  <span class="designation">{flagship.data.designation}</span>
                )}
                {flagship.data.summary}
              </Fragment>
            </SectionHead>

            <div>
              {flagship.data.description && (
                <p class="flagship-body">{flagship.data.description}</p>
              )}
              {flagship.data.focus.length > 0 && (
                <ul class="focus" aria-label="Subsystems">
                  {flagship.data.focus.map((f) => (
                    <li class="chip outline">{f}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>

          <dl class="spec card">
            <div>
              <dt>Status</dt>
              <dd>
                <span class="chip">
                  <span class="pulse" aria-hidden="true" />
                  {programStatus}
                </span>
              </dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{flagship.data.kind}, full-scale</dd>
            </div>
            {launched && (
              <div>
                <dt>Launched</dt>
                <dd>{launched}</dd>
              </div>
            )}
            {lastWhen && (
              <div>
                <dt>Target</dt>
                <dd>{lastWhen}</dd>
              </div>
            )}
            {outputsLine && (
              <div>
                <dt>Outputs</dt>
                <dd>{outputsLine}</dd>
              </div>
            )}
            <div>
              <dt>Licence</dt>
              <dd>{SITE.license}</dd>
            </div>
          </dl>
        </div>

        {milestones.length > 0 && (
          <div class="schedule">
            <SectionHead as="h3" size="sm" eyebrow="2026–27 roadmap" title="The schedule" />
            <ol class="timeline" style={`--stops: ${milestones.length}`}>
              {milestones.map((m, i) => (
                <li
                  class:list={['stop', { done: i < current, current: i === current }]}
                  style={`--fill: ${fills[i]!.toFixed(3)}`}
                >
                  <span class="stop-line" aria-hidden="true">
                    <span class="stop-fill" />
                  </span>
                  <span class="stop-node" aria-hidden="true" />
                  <span class="stop-when">
                    {m.when}
                    {i === current && <span class="chip solid">Now</span>}
                    {i < current && <span class="sr-only">(done)</span>}
                  </span>
                  <strong>{m.title}</strong>
                  <p>{m.body}</p>
                </li>
              ))}
            </ol>
          </div>
        )}

        {otherPrograms.length > 0 && (
          <div class="also">
            <SectionHead as="h3" size="sm" eyebrow="Beyond H1" title="Also on the roadmap">
              <a slot="aside" class="link-arrow" href="/projects#roadmap">
                See the roadmap <Icon name="lucide:arrow-right" aria-hidden="true" />
              </a>
            </SectionHead>
            <div class="also-grid">
              {otherPrograms.map((p, i) => (
                <article class="track card lift">
                  <p class="track-kind">
                    {p.data.kind}
                    {p.data.level && <> · {p.data.level}</>}
                  </p>
                  <h4>
                    <a class="stretch" href={`/projects#${p.id}`}>
                      {p.data.title}
                    </a>
                  </h4>
                  <p class="track-body">{p.data.summary}</p>
                  <span class="chip">
                    {[STATUS_LABEL[p.data.status], p.data.timeframe].filter(Boolean).join(' · ')}
                  </span>
                </article>
              ))}
            </div>
          </div>
        )}
      </Section>
    )
  }

  <!-- ============================================================
       Get involved: four cards, each opening a pop-up
       ============================================================ -->
  <Section id="join">
    <SectionHead
      eyebrow="Get involved"
      title="Four ways in. Start where you fit."
      lede="Whether you are a student, a club, a lab or a company, there is a place for you. Open a card to see what each involves."
    />

    <div class="ways">
      {
        ways.map((w, i) => (
          <article class="way card lift">
            <span class="way-icon" aria-hidden="true">
              <Icon name={w.iconName} />
            </span>
            <p class="way-who">{w.audience}</p>
            <h3>{w.title}</h3>
            <p class="way-lede">{w.lede}</p>
            <ul class="way-points">
              {w.points.map((p) => (
                <li>
                  <Icon name="lucide:check" aria-hidden="true" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
            <button
              type="button"
              class="way-open stretch"
              data-modal-open={w.dialogId}
              aria-haspopup="dialog"
            >
              <span>
                See what’s involved<span class="sr-only">: {w.title}</span>
              </span>
              <Icon name="lucide:arrow-up-right" aria-hidden="true" />
            </button>
          </article>
        ))
      }
    </div>

    <p class="ways-note">
      Not sure which fits? <a href={mailto(general, 'Getting involved')}>Email {general}</a> and we will
      point you the right way.
    </p>
  </Section>

  {
    ways.map((w) => (
      <dialog
        class:list={['modal', 'way-modal', { wide: w.wide }]}
        id={w.dialogId}
        aria-labelledby={`${w.dialogId}-title`}
      >
        <button type="button" class="modal-close" data-modal-close aria-label="Close">
          <Icon name="lucide:x" aria-hidden="true" />
        </button>

        <div class="modal-scroll">
          <header class="wm-head">
            <span class="way-icon" aria-hidden="true">
              <Icon name={w.iconName} />
            </span>
            <div>
              <p class="eyebrow plain">{w.audience}</p>
              <h2 id={`${w.dialogId}-title`}>{w.title}</h2>
              <p class="wm-lede">{w.lede}</p>
            </div>
          </header>

          <div class="wm-body">
            <p class="wm-intro">{w.intro}</p>

            {/* Lists sit side by side where there is room; a table or a
                paragraph takes the full width. */}
            <div class="wm-sections">
              {w.sections.map((s) => (
                <section class:list={{ full: !s.items }}>
                  <h3>{s.heading}</h3>
                  {s.items && (
                    <ul>
                      {s.items.map((item) => (
                        <li>
                          <Icon name="lucide:check" aria-hidden="true" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {s.table && (
                    <DataTable
                      columns={s.table.columns}
                      rows={s.table.rows.map((r) => r.cells)}
                      note={s.table.note}
                      label={s.heading}
                    />
                  )}
                  {s.text && <p class="wm-text">{s.text}</p>}
                </section>
              ))}
            </div>

            {w.notes.length > 0 && (
              <div class="wm-notes">
                {w.notes.map((n) => (
                  <aside class="wm-note">
                    <p class="wm-note-label">{n.label}</p>
                    <p>{n.body}</p>
                  </aside>
                ))}
              </div>
            )}

            {w.start && (
              <section class="wm-start">
                <h3>How to start</h3>
                <p>{w.start}</p>
              </section>
            )}
          </div>

          <footer class="wm-foot">
            <a class="btn" href={w.href}>
              {w.cta} <Icon name="lucide:arrow-right" class="arrow" aria-hidden="true" />
            </a>
            {w.secondary ? (
              <a class="btn secondary" href={w.secondaryHref}>
                {w.secondary.label}
              </a>
            ) : (
              <a class="btn quiet" href="/contact">
                Other ways to reach us
              </a>
            )}
          </footer>
        </div>
      </dialog>
    ))
  }

  <!-- ============================================================
       Recent activity
       ============================================================ -->
  {
    activity.length > 0 && (
      <Section id="latest" tone="white">
        <SectionHead eyebrow="Elsewhere" title="Recent activity" />
        <ul class="activity-list">
          {activity.map((item) => (
            <li>
              <a href={item.href} rel="noopener" target="_blank">
                <span class="a-kind chip outline">{item.kind}</span>
                <span class="a-title">{item.title}</span>
                <span class="a-src">{item.source}</span>
                <span class="a-date">
                  {item.date && <time datetime={item.date.toISOString()}>{fmt(item.date)}</time>}
                </span>
                <Icon name="lucide:arrow-up-right" class="a-go" aria-hidden="true" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- ============================================================
       Partners
       ============================================================ -->
  <Section id="partners" pad="flush-bottom">
    <SectionHead eyebrow="Partners" title="The clubs and schools in the network.">
      <span slot="aside">{partners.length} partners · {schoolCount} schools</span>
    </SectionHead>

    <div class="roster">
      {
        partners.map((p, i) => (
          <a class="tile card lift" href={p.data.url} rel="noopener" target="_blank">
            <span class="tile-top">
              <span class="chip">{KIND_LABEL[p.data.kind]}</span>
              <Icon name="lucide:arrow-up-right" class="tile-go" aria-hidden="true" />
            </span>
            <span class="tile-mark">
              <PartnerMark partner={p} height={64} maxWidth={132} decorative />
            </span>
            <span class="tile-name">{p.data.name}</span>
            <span class="tile-meta">
              {[p.data.kind !== 'school' && p.data.school, p.data.location]
                .filter(Boolean)
                .join(' · ')}
            </span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        ))
      }
      <a class="tile open" href="#join">
        <span class="open-plus" aria-hidden="true">
          <Icon name="lucide:plus" />
        </span>
        <span class="open-text">
          <span class="tile-name">Your team here</span>
          <span class="tile-meta">Clubs, labs and companies welcome</span>
        </span>
        <span class="link-arrow">
          Get involved <Icon name="lucide:arrow-right" aria-hidden="true" />
        </span>
      </a>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ================================================================
   * Hero
   * ============================================================== */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem) 0;
    isolation: isolate;
  }

  /* A cool light from one corner and a warm one from the other, fading
     into the page. It runs up behind the translucent header. */
  .hero-wash {
    position: absolute;
    inset: calc(-1 * var(--header-h)) 0 0;
    z-index: -1;
    background:
      radial-gradient(60rem 34rem at 92% 6%, var(--blue-soft), transparent 62%),
      radial-gradient(48rem 30rem at 0% 0%, var(--band), transparent 64%);
    -webkit-mask-image: linear-gradient(#000 60%, transparent);
    mask-image: linear-gradient(#000 60%, transparent);
    pointer-events: none;
  }

  .hero-grid {
    max-width: 52rem;
    text-align: center;
  }

  .hero h1 {
    margin-top: var(--space-5);
    font-size: var(--t-hero);
    font-weight: var(--w-semibold);
    line-height: 1;
    letter-spacing: var(--track-display);
  }

  .hero .lede {
    margin: var(--space-5) auto 0;
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  /* Five facts in one row where they fit. Where they don't, they wrap
     into centred rows, so a fact left over never sits stranded at one
     side. */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-7);
    margin: var(--space-7) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .hero-facts div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.125rem;
  }

  .hero-facts dt {
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .hero-facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: var(--w-semibold);
    line-height: 1.1;
    letter-spacing: var(--track-tight);
    color: var(--ink-strong);
    font-variant-numeric: lining-nums;
  }

  /* A name, not a number: set a little smaller so it sits on the same line. */
  .hero-facts dd.text {
    font-size: 1.375rem;
    line-height: 1.6;
  }

  /* --- the partners, under the fold line --------------------------- */
  .trust {
    display: flex;
    align-items: center;
    gap: var(--space-5) var(--space-7);
    flex-wrap: wrap;
    margin-top: clamp(3rem, 7vw, 5.5rem);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .trust-label {
    flex: none;
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .trust-list {
    display: flex;
    align-items: center;
    flex: 1;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Every mark takes its colour from the link, so they all print in the
     same ink and all turn blue the same way. */
  .trust-list a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 2.5rem;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .trust-name {
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    line-height: 1.2;
    white-space: nowrap;
  }

  .trust-list a:hover {
    color: var(--blue);
  }

  .trust-all {
    flex: none;
    font-size: var(--t-sm);
  }

  /* ================================================================
   * Why
   * ============================================================== */
  .why-copy {
    text-align: center;
  }

  .why-copy :global(.section-head) {
    margin-bottom: var(--space-5);
  }

  .why-body p {
    max-width: var(--measure);
    margin: 0 auto;
    font-size: var(--t-md);
  }

  .why-body p + p {
    margin-top: var(--space-4);
  }

  /* Centred under the copy, so the accent rule runs along the top
     rather than down one side. */
  .example {
    max-width: var(--measure);
    margin: var(--space-6) auto 0;
    padding: var(--space-4) var(--space-5);
    border-top: 3px solid var(--blue);
    border-radius: 0 0 var(--r-md) var(--r-md);
    background: var(--blue-wash);
  }

  .example p {
    margin: 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  .example .example-label {
    margin-bottom: var(--space-1);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue-strong);
  }

  .model,
  .roles,
  .process {
    margin-top: var(--space-9);
  }

  /* --- why the model works ---------------------------------------- */
  .reasons {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reason {
    padding-top: var(--space-4);
    border-top: 2px solid var(--blue);
  }

  .reason h4 {
    font-size: var(--t-xl);
  }

  .reason p {
    margin: var(--space-2) 0 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  /* --- who does what ------------------------------------------------
     Three supporting roles in a row. A rule drops from each into one
     bar, and from the bar down into the university teams they serve. */
  .roles-figure {
    --drop: var(--space-6);
    --gap: var(--space-5);
    margin: 0;
    text-align: center;
  }

  .supports {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role {
    padding: var(--space-5);
  }

  .role h4 {
    font-size: var(--t-lg);
  }

  .role p {
    margin: var(--space-2) 0 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-body);
  }

  .supports .role::after,
  .role-bus,
  .role-bus::after {
    background: var(--rule-strong);
  }

  .supports .role::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1px;
    height: var(--drop);
  }

  /* The bar runs from the first card's centre to the last one's: a sixth
     of the row (less its gaps) in from either side. */
  .role-bus {
    position: relative;
    height: 1px;
    margin: var(--drop) calc((100% - 2 * var(--gap)) / 6) 0;
  }

  .role-bus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: var(--drop);
  }

  .teams {
    max-width: 34rem;
    margin: var(--drop) auto 0;
    border-color: var(--blue-soft);
    background: var(--blue-wash);
  }

  /* Where the line arrives. */
  .teams::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -0.3125rem;
    width: 0.625rem;
    height: 0.625rem;
    margin-left: -0.3125rem;
    border-radius: 50%;
    background: var(--blue);
  }

  .teams h4 {
    font-size: var(--t-xl);
    color: var(--blue-strong);
  }

  .teams p {
    font-size: var(--t-base);
  }

  .roles-figure figcaption {
    max-width: var(--measure);
    margin: var(--space-5) auto 0;
    font-size: var(--t-base);
    color: var(--ink-muted);
  }

  /* --- how a joint build works --------------------------------------
     Five across on a wide screen. Narrower, a row of three with the
     last two centred beneath it, on six tracks; then one column. */
  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-5);
  }

  .step .chip {
    white-space: normal;
  }

  /* An arrow in the gap, from each step to the next. */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 3rem;
    right: calc(-1 * var(--space-5));
    width: var(--space-5);
    height: 1px;
    background: var(--rule-strong);
  }

  .step-no {
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .step h4 {
    margin-top: var(--space-4);
    font-size: var(--t-xl);
  }

  .step p {
    flex: 1;
    margin: var(--space-2) 0 var(--space-5);
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  /* ================================================================
   * Flagship
   * ============================================================== */
  .flagship {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: start;
    gap: var(--space-8);
  }

  .flagship-copy :global(.section-head) {
    margin-bottom: var(--space-5);
  }

  .flagship-copy :global(.title) {
    max-width: 16ch;
  }

  /* "H1": the program's name, set as the first line of its heading. */
  .designation {
    display: block;
  }

  .flagship-body {
    max-width: var(--measure);
    margin: 0;
    font-size: var(--t-md);
  }

  .focus {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .focus .chip.outline {
    background: var(--bg);
    color: var(--ink-body);
  }

  .spec {
    margin: 0;
    padding: var(--space-2) var(--space-6);
  }

  .spec div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .spec div:last-child {
    border-bottom: 0;
  }

  .spec dt {
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .spec dd {
    margin: 0;
    font-weight: var(--w-medium);
    color: var(--ink-strong);
  }

  /* --- the schedule ------------------------------------------------ */
  .schedule,
  .also {
    margin-top: var(--space-9);
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(var(--stops, 4), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stop {
    position: relative;
    padding: 2.75rem var(--space-5) 0 0;
  }

  /* The run from this milestone to the next: a track, and the part of
     it that has already elapsed. */
  .stop-line {
    position: absolute;
    left: 0.5rem;
    right: -0.5rem;
    top: 0.5rem;
    height: 2px;
    margin-top: -1px;
    background: var(--band-edge);
  }

  /* The last run has no milestone to arrive at; it tails off. */
  .stop:last-child .stop-line {
    right: 0;
    -webkit-mask-image: linear-gradient(90deg, #000, transparent);
    mask-image: linear-gradient(90deg, #000, transparent);
  }

  .stop-fill {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: left center;
    scale: var(--fill) 1;
  }

  .stop-node {
    position: absolute;
    left: 0;
    top: 0;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--band-edge);
    border-radius: 50%;
    background: var(--band);
  }

  .stop.done .stop-node {
    border-color: var(--blue);
    background: var(--blue);
  }

  .stop.current .stop-node {
    border-color: var(--blue);
    background: var(--surface);
    box-shadow: 0 0 0 5px rgba(36, 80, 200, 0.16);
  }

  .stop-when {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-muted);
  }

  .stop.current .stop-when {
    color: var(--blue-strong);
  }

  .stop strong {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: var(--w-semibold);
    line-height: 1.25;
    letter-spacing: var(--track-tight);
    color: var(--ink-strong);
  }

  .stop p {
    margin: var(--space-2) 0 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-body);
  }

  /* --- also on the roadmap ----------------------------------------- */
  .also-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .track {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-6);
  }

  .track-kind {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue);
  }

  .track h4 {
    margin-top: var(--space-3);
    font-size: var(--t-xl);
  }

  .track h4 a {
    color: inherit;
    text-decoration: none;
  }

  .track:hover h4 a {
    color: var(--blue);
  }

  .track-body {
    flex: 1;
    margin: var(--space-2) 0 var(--space-5);
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  /* ================================================================
   * Ways in
   * ============================================================== */
  .ways {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .way {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
  }

  /* Cards side by side share their rows, so a shorter lede on one card
     does not lift its checklist above its neighbours'. Six rows: icon,
     audience, title, lede, checklist, button. */
  @supports (grid-template-rows: subgrid) {
    .way {
      display: grid;
      grid-row: span 6;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }

  .way-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-md);
    background: var(--blue-wash);
    color: var(--blue);
    transition:
      background-color var(--dur-slow) var(--ease),
      color var(--dur-slow) var(--ease);
  }

  .way-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* :focus-visible, not :focus-within: closing the pop-up hands focus back
     to the button that opened it, and a mouse user would otherwise be left
     with a lit icon long after the pointer has gone. Keyboard focus
     still lights it. */
  .way:hover .way-icon,
  .way:has(:focus-visible) .way-icon {
    background: var(--blue);
    color: var(--ink-inverse);
  }

  .way-who {
    margin: var(--space-5) 0 0;
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--blue);
  }

  .way h3 {
    margin-top: var(--space-2);
    font-size: var(--t-h3);
  }

  .way-lede {
    margin: var(--space-2) 0 0;
    font-size: var(--t-md);
    color: var(--ink-body);
  }

  .way-points,
  .wm-sections ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .way-points {
    flex: 1;
    align-content: start;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-soft);
  }

  .way-points li,
  .wm-sections li {
    display: grid;
    grid-template-columns: 1.125rem minmax(0, 1fr);
    gap: var(--space-3);
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--ink-body);
  }

  .way-points :global(svg),
  .wm-sections :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.15rem;
    color: var(--blue);
  }

  /* The button that opens the pop-up. It is stretched over the whole
     card (.stretch), so anywhere on the card opens it. */
  .way-open {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    background: var(--bg);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--ink-strong);
    text-align: left;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .way-open :global(svg) {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  .way:hover .way-open,
  .way-open:focus-visible {
    border-color: var(--blue);
    background: var(--blue);
    color: var(--ink-inverse);
  }

  .ways-note {
    margin: var(--space-6) 0 0;
    font-size: var(--t-base);
    color: var(--ink-muted);
    text-align: center;
  }

  .ways-note a {
    font-weight: var(--w-semibold);
    color: var(--blue);
  }

  /* --- the pop-up -------------------------------------------------- */

  /* Room for a four-column table (the partnership levels). */
  .way-modal.wide {
    width: min(60rem, calc(100vw - 2rem));
  }

  .way-modal .modal-close {
    position: absolute;
    right: var(--space-4);
    top: var(--space-4);
    z-index: 2;
  }

  .wm-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-7) var(--space-7) var(--space-5);
    padding-right: 4.5rem;
    background: linear-gradient(var(--blue-wash), var(--surface));
  }

  .wm-head .way-icon {
    width: 3.5rem;
    height: 3.5rem;
    background: var(--blue);
    color: var(--ink-inverse);
  }

  .wm-head h2 {
    margin-top: var(--space-1);
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.25rem);
  }

  .wm-lede {
    margin: var(--space-2) 0 0;
    font-size: var(--t-lg);
    color: var(--ink-body);
  }

  .wm-body {
    padding: var(--space-2) var(--space-7) var(--space-6);
  }

  .wm-intro {
    margin: 0;
    font-size: var(--t-md);
    color: var(--ink-body);
  }

  .wm-notes {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .wm-note {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--band-edge);
    border-radius: var(--r-md);
    background: var(--band);
  }

  .wm-note p {
    margin: 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  .wm-note .wm-note-label {
    margin-bottom: var(--space-1);
    font-family: var(--font-label);
    font-size: var(--t-xs);
    font-weight: var(--w-semibold);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Lists share a row where there is room, each growing to fill it; a
     table or a paragraph always takes a row of its own. Flex rather than
     grid, so a list left alone on a row grows to the full width instead
     of leaving an empty track beside it. */
  .wm-sections {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .wm-sections > section {
    flex: 1 1 13rem;
    /* Lets a wide table scroll inside its own box instead of stretching
       the pop-up. */
    min-width: 0;
  }

  .wm-sections > section.full {
    flex-basis: 100%;
  }

  .wm-text {
    margin: 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  .wm-body h3 {
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--t-base);
    font-weight: var(--w-semibold);
    letter-spacing: 0;
    color: var(--ink-strong);
  }

  .wm-start {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-soft);
  }

  .wm-start p {
    margin: 0;
    font-size: var(--t-base);
    color: var(--ink-body);
  }

  /* The actions stay in view while the card's body scrolls. */
  .wm-foot {
    position: sticky;
    bottom: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-7);
    border-top: 1px solid var(--rule-soft);
    background: var(--surface);
  }

  /* ================================================================
   * Recent activity
   * ============================================================== */
  .activity-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .activity-list a {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) 11rem 7rem 1.25rem;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--rule-soft);
    color: var(--ink-strong);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }

  .activity-list a:hover {
    background: var(--blue-wash);
  }

  .a-kind {
    justify-self: start;
  }

  .a-title {
    overflow: hidden;
    font-weight: var(--w-medium);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .a-src,
  .a-date {
    overflow: hidden;
    font-size: var(--t-sm);
    color: var(--ink-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .a-date {
    text-align: right;
  }

  .a-go {
    width: 1.125rem;
