---
/**
 * Colophon — how the site is built.
 *
 * In keeping with building in public: the site documents its own
 * construction the same way the hardware repos document theirs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import Prose from '../components/ui/Prose.astro';
import { SITE, buildInfo } from '../data/site';

const build = buildInfo();
---

<BaseLayout title="Colophon" description="How this site is built, and what it is built from.">
  <PageHero
    eyebrow="Colophon"
    title="How this site is made."
    lede="The site documents its own construction the same way the hardware repositories document theirs."
    narrow
  >
    <Fragment slot="title">How this site is <em>made.</em></Fragment>
  </PageHero>

  <Section pad="flush-top" width="narrow">
    <Prose>
      <h2>Construction</h2>
      <p>
        Built with <a href="https://astro.build" rel="noopener">Astro</a> and prerendered to static HTML,
        deployed on Vercel. Source is at{' '}
        <a href={SITE.repoUrl} rel="noopener">{SITE.repo}</a>.
      </p>
      <p>
        External data — repository statistics, video listings — is fetched at build time rather than
        in the browser, so pages ship as plain HTML with no client-side data fetching. A scheduled
        rebuild keeps that data current without anyone running a build. Where a source is
        unavailable, the affected section renders without it; no figure on this site is a
        placeholder.
      </p>
      <p>
        Search runs entirely in your browser, against a small index generated with the rest of the
        site; there is no search service behind it. The events calendar is the one exception to the
        build-time rule: it is embedded live from Google Calendar, so a new date shows up without a
        deploy.
      </p>

      <h2>Typography</h2>
      <p>
        Headlines are set in{' '}
        <a href="https://fonts.google.com/specimen/Fraunces" rel="noopener">Fraunces</a>, a soft
        old-style serif with an optical-size axis that keeps large settings delicate. Running text
        and the interface are in <a href="https://rsms.me/inter/" rel="noopener">Inter</a>; code and
        figures in tables are in <a href="https://www.ibm.com/plex/" rel="noopener">IBM Plex Mono</a
        >. All three are open-licence families, and all are served from this site rather than a font
        service.
      </p>

      <h2>Colour</h2>
      <p>
        A warm-white page with beige bands, deep navy ink, and a single blue for everything you can
        act on. Partner logos are redrawn in that same ink at build time, so none of them clash with
        the page or each other. Text contrast is enforced in CI: every text-and-surface pair is
        measured against WCAG&nbsp;AA, and the build fails below it.
      </p>

      <h2>Motion</h2>
      <p>
        Blocks rise into place the first time they scroll into view, cards lift toward the pointer,
        and buttons sink when pressed. All of it stands down for anyone whose system asks for
        reduced motion, and none of it is needed to read or use the site.
      </p>

      <h2>This build</h2>
    </Prose>

    <dl class="build-facts">
      <div>
        <dt>Branch</dt>
        <dd>{build.ref}</dd>
      </div>
      <div>
        <dt>Commit</dt>
        <dd>
          {
            build.sha ? (
              <a href={build.commitUrl} rel="noopener">
                {build.sha}
              </a>
            ) : (
              'local'
            )
          }
        </dd>
      </div>
      <div>
        <dt>Built</dt>
        <dd>{build.date}</dd>
      </div>
      <div>
        <dt>Licence</dt>
        <dd>{SITE.license}</dd>
      </div>
    </dl>
  </Section>
</BaseLayout>

<style>
  .build-facts {
    max-width: var(--measure);
    margin: var(--space-4) 0 0;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--rule-soft);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
  }

  .build-facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .build-facts div:last-child {
    border-bottom: 0;
  }

  dt {
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    color: var(--ink-strong);
  }

  dd a {
    color: var(--blue);
  }
</style>
