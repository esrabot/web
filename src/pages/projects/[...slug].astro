---
/**
 * A curated project page — for work that needs more than a repo card,
 * or that has no repo of its own yet.
 */
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Article from '../../components/ui/Article.astro';
import LinkChip from '../../components/ui/LinkChip.astro';
import { mdxComponents } from '../../components/blog';
import { getRepo, updatedLabel } from '../../lib/github';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(
    (p) => import.meta.env.DEV || !p.data.draft
  );
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const repo = project.data.repo ? await getRepo(project.data.repo) : null;

const STATUS = {
  active: 'Active',
  prototype: 'Prototype',
  shipped: 'Shipped',
  archived: 'Archived',
};
const eyebrow = ['Project', STATUS[project.data.status], project.data.revision]
  .filter(Boolean)
  .join(' · ');

const repoFacts = repo
  ? [repo.language, repo.stars > 0 && `★ ${repo.stars}`, updatedLabel(repo.pushedAt)].filter(
      Boolean
    )
  : [];

const hasLinks = Boolean(repo) || project.data.links.length > 0;
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <Article
    eyebrow={eyebrow}
    title={project.data.title}
    lede={project.data.summary}
    back={{ href: '/projects', label: 'All projects' }}
  >
    {
      (hasLinks || project.data.domains.length > 0) && (
        <Fragment slot="meta">
          {hasLinks && (
            <div class="chips">
              {repo && <LinkChip href={repo.url} platform="github" label={repo.fullName} />}
              {project.data.links.map((l) => (
                <LinkChip href={l.url} label={l.label} />
              ))}
            </div>
          )}
          {(project.data.domains.length > 0 || repoFacts.length > 0) && (
            <p class="facts">{[...project.data.domains, ...repoFacts].join(' · ')}</p>
          )}
        </Fragment>
      )
    }

    <Content components={mdxComponents} />
  </Article>
</BaseLayout>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .facts {
    margin: var(--space-4) 0 0;
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  .facts:first-child {
    margin-top: 0;
  }
</style>
