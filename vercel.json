{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,

  "redirects": [
    {
      "source": "/team",
      "destination": "/members",
      "permanent": true
    },
    {
      "source": "/team/:path*",
      "destination": "/members",
      "permanent": true
    },
    {
      "source": "/docs/index",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/calendar",
      "destination": "/events",
      "permanent": false
    },
    { "source": "/blog", "destination": "/", "permanent": true },
    { "source": "/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/gallery", "destination": "/", "permanent": true },
    { "source": "/gallery/:path*", "destination": "/", "permanent": true },
    { "source": "/rss.xml", "destination": "/", "permanent": true },
    { "source": "/rss", "destination": "/", "permanent": true },
    { "source": "/feed", "destination": "/", "permanent": true },
    { "source": "/feed.xml", "destination": "/", "permanent": true },
    { "source": "/feed-media/:path*", "destination": "/", "permanent": true },
    { "source": "/media/:path*", "destination": "/", "permanent": true }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
